    "Finish a painting and it hangs here." : {
      "comment" : "Finished Paintings widget with no finished painting to show",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mal ein Bild fertig, dann hängt es hier."
          }
