    "The stones, pigments, glass and other materials of Roman and Byzantine mosaic that the paints are named after.": {
      "comment": "Footer under The Paints’ Names in Acknowledgements",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Steine, Pigmente, Gläser und anderen Materialien römischer und byzantinischer Mosaike, nach denen die Farben benannt sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las piedras, pigmentos, vidrios y otros materiales del mosaico romano y bizantino que dan nombre a las pinturas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pierres, pigments, verres et autres matériaux de la mosaïque romaine et byzantine qui donnent leur nom aux peintures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pietre, i pigmenti, i vetri e gli altri materiali del mosaico romano e bizantino da cui prendono il nome i colori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵の具の名前のもとになった、ローマやビザンティンのモザイクの石、顔料、ガラスなどの素材です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물감 이름의 바탕이 된 로마와 비잔틴 모자이크의 돌, 안료, 유리와 그 밖의 재료예요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De stenen, pigmenten, glassoorten en andere materialen uit Romeinse en Byzantijnse mozaïeken waarnaar de verven zijn genoemd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pedras, os pigmentos, o vidro e outros materiais dos mosaicos romanos e bizantinos que dão nome às tintas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜料名字所取自的罗马和拜占庭马赛克中的石材、颜料、玻璃及其他材料。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顏料名稱所依據的羅馬與拜占庭馬賽克石材、色料、玻璃及其他材料。"
          }
        }
      }
    },
