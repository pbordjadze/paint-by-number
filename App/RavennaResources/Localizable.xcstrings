    "gallery.notice.progressReset": {
      "comment": "Toast when a painting's saved progress was unreadable and has been reset",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gesicherte Fortschritt dieses Mosaiks ließ sich nicht lesen, deshalb beginnt es neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This mosaic’s saved progress couldn’t be read, so it starts fresh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el progreso guardado de este mosaico, así que empieza de cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La progression enregistrée de cette mosaïque n’a pas pu être lue : elle repart de zéro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere i progressi salvati di questo mosaico, quindi riparte da capo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモザイクの保存された進み具合を読み込めなかったので、最初からになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모자이크의 저장된 진행 상황을 읽을 수 없어서 처음부터 시작해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bewaarde voortgang van dit mozaïek kon niet worden gelezen, dus het begint opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o progresso salvo deste mosaico, então ele recomeça do zero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取这幅马赛克存储的进度，所以要从头开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取這幅馬賽克儲存的進度，所以會重新開始。"
          }
        }
      }
    },
