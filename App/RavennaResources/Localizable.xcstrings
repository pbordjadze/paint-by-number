    "This device can’t draw the mosaic right now. Your progress is saved.": {
      "comment": "Message of the screen shown when the canvas can't be drawn",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann das Mosaik gerade nicht zeichnen. Dein Fortschritt ist gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no puede dibujar el mosaico ahora mismo. Tu progreso está guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas afficher la mosaïque pour l’instant. Votre progression est enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non riesce a disegnare il mosaico in questo momento. I tuoi progressi sono salvati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは今、モザイクを表示できません。進み具合は保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 이 기기에서 모자이크를 그릴 수 없어요. 진행 상황은 저장되어 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat kan het mozaïek nu niet tekenen. Je voortgang is bewaard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este aparelho não consegue desenhar o mosaico agora. Seu progresso está salvo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备暂时无法绘制这幅马赛克。你的进度已存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部裝置目前無法顯示馬賽克。你的進度已經儲存。"
          }
        }
      }
    },
    "This mosaic can’t be restarted.": {
      "comment": "Alert title in the gallery when Restart couldn't read the painting (written by a newer app, or its files can't be read just now); nothing was changed",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
