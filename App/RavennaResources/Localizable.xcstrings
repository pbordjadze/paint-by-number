    "Replay Mosaic plays your mosaic back from the first tile.": {
      "comment": "Message of the tip titled Watch It Again; Replay Painting plays a finished painting back from its first fill",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Mosaik abspielen“ spielt dein Mosaik ab dem ersten Steinchen noch einmal ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
