    "paint.zen.on": {
      "comment": "Painting screen: a toast for a few seconds after Zen Mode is turned on in the More menu, saying what it does to the view",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zen-Modus ist an: Nach jedem gesetzten Steinchen gleitet das Mosaik zum nächsten Steinchen deiner Farbe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen Mode is on: after each tile you set, the mosaic glides to the next tile of your color."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Modo Zen está activado: después de cada tesela que colocas, el mosaico se desliza hasta la siguiente tesela de tu color."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode zen est activé : après chaque tesselle posée, la mosaïque glisse jusqu’à la tesselle suivante de votre couleur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Modalità Zen è attiva: dopo ogni tessera posata, il mosaico scivola alla tessera successiva del tuo colore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "禅モードがオンです。タイルをはめるたびに、モザイクが同じ色の次のタイルへすべるように移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "젠 모드가 켜졌어요. 타일을 하나 붙일 때마다 모자이크가 같은 색의 다음 타일로 부드럽게 옮겨 가요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen-modus staat aan: na elk steentje dat je legt, glijdt het mozaïek naar het volgende steentje van je kleur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Modo Zen está ativado: depois de cada pastilha que você assenta, o mosaico desliza até a próxima pastilha da sua cor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禅模式已打开：你每镶好一块嵌片，马赛克就会平滑地移到你这个颜色的下一块嵌片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「禪模式」已開啟：每鑲好一片嵌片，馬賽克就會滑到你這個顏色的下一片。"
          }
        }
      }
    },
