    "Take the gold ground off where it shouldn’t be.": {
      "comment": "Refine's hint: the Gold tool erasing",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm den Goldgrund dort weg, wo er nicht sein soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita el fondo dorado donde no debe ir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez le fond d’or là où il ne doit pas être."
          }
        },
        "it": {
