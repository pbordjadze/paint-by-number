    "The gear holds the finish, the sound and the paper. Tips can be turned off there.": {
      "comment": "Message of the tip titled Settings and Tips; the gear is the gallery’s Settings button",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Zahnrad findest du Oberfläche, Klang und Papier. Dort lassen sich auch die Tipps ausschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El engranaje guarda el acabado, el sonido y el papel. Allí puedes desactivar los consejos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La roue dentée donne accès à la finition, au son et au papier. Les astuces peuvent y être désactivées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ingranaggio contiene la finitura, il suono e la carta. Lì puoi anche disattivare i consigli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歯車のボタンで、仕上がり、サウンド、紙を設定できます。ヒントもそこでオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "톱니바퀴에서 마감, 사운드, 종이를 정할 수 있어요. 팁도 그곳에서 끌 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onder het tandwiel vind je de afwerking, het geluid en het papier. Daar kun je ook de tips uitzetten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A engrenagem guarda o acabamento, o som e o papel. As dicas podem ser desativadas ali."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "齿轮里有成品效果、声音和纸张。也可以在那里关闭小提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "齒輪裡有表面處理、聲音和紙張。也可以在那裡關閉提示。"
          }
        }
      }
    },
