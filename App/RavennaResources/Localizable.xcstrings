            "state": "translated",
            "value": "このモザイクはやり直せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모자이크는 다시 시작할 수 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit mozaïek kan niet opnieuw beginnen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
