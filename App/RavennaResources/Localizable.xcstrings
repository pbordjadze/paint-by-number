    "Touch and hold a finished mosaic and choose Share for a time-lapse of it.": {
      "comment": "Message of the tip titled Share the Making; a time-lapse is a movie of the painting being painted",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein fertiges Mosaik gedrückt und wähle „Teilen“, um einen Zeitraffer davon zu bekommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un mosaico terminado y elige Compartir para obtener su time-lapse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez et maintenez une mosaïque terminée, puis choisissez Partager pour en obtenir une vidéo en accéléré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca e tieni premuto un mosaico finito e scegli Condividi per averne un time-lapse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完成したモザイクを長押しして「共有」を選ぶと、タイムラプスを共有できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완성한 모자이크를 길게 누르고 공유를 고르면 타임랩스로 나눌 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een voltooid mozaïek vast en kies Deel voor een timelapse ervan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e mantenha um mosaico concluído e escolha Compartilhar para ter um time-lapse dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住一幅完成的马赛克，选择“分享”，即可得到它的延时视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住一幅已完成的馬賽克，選擇「分享」，即可取得它的縮時影片。"
          }
        }
      }
    },
    "Touch and hold a mosaic to favorite, rename, share, print or start it over.": {
      "comment": "Message of the tip titled More for Each Painting, about a gallery card’s touch-and-hold menu",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein Mosaik gedrückt, um es zu favorisieren, umzubenennen, zu teilen, zu drucken oder neu zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un mosaico para marcarlo como favorito, cambiarle el nombre, compartirlo, imprimirlo o empezarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez et maintenez une mosaïque pour l’ajouter aux favoris, la renommer, la partager, l’imprimer ou la recommencer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca e tieni premuto un mosaico per aggiungerlo ai preferiti, rinominarlo, condividerlo, stamparlo o ricominciarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モザイクを長押しすると、お気に入りに追加、名前の変更、共有、印刷、やり直しができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모자이크를 길게 누르면 즐겨찾기, 이름 바꾸기, 공유, 인쇄, 다시 시작을 할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een mozaïek vast om het favoriet te maken, een nieuwe naam te geven, te delen, te printen of opnieuw te beginnen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e mantenha um mosaico para favoritar, renomear, compartilhar, imprimir ou recomeçar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住一幅马赛克，可以收藏、重命名、分享、打印或重新开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住馬賽克，即可加入喜好項目、重新命名、分享、列印或重新開始。"
          }
        }
      }
    },
    "Touch and hold a mosaic, then choose Favorite.": {
      "comment": "Explanation under the No Favorites empty state of the gallery; Favorite is the context menu item's name",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein Mosaik gedrückt und wähle dann „Favorit“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un mosaico y elige Favorito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez et maintenez une mosaïque, puis choisissez Ajouter aux favoris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca e tieni premuto un mosaico, poi scegli Preferito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モザイクを長押しして、「お気に入り」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모자이크를 길게 누른 다음 즐겨찾기를 고르세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een mozaïek vast en kies dan Favoriet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e mantenha um mosaico, depois escolha Favoritar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住一幅马赛克，然后选择“收藏”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住一幅馬賽克，然後選擇「喜好」。"
          }
        }
      }
    },
    "Touch and hold to compare with the photo. Tap to keep it shown.": {
      "comment": "VoiceOver hint of the Photo control on the painting screen",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berühren und halten, um mit dem Foto zu vergleichen. Tippen, damit es sichtbar bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado para comparar con la foto. Toca para que siga visible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez et maintenez pour comparer avec la photo. Touchez pour la garder affichée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca e tieni premuto per confrontare con la foto. Tocca per lasciarla visibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しすると写真と比べられます。タップすると表示したままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길게 누르면 사진과 비교할 수 있어요. 탭하면 계속 보여요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd vast om te vergelijken met de foto. Tik om haar te laten staan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e mantenha para comparar com a foto. Toque para deixar à mostra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住可与照片对比。轻点可让照片保持显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住即可與照片比較。點一下則會讓它持續顯示。"
          }
        }
      }
    },
    "Touch and hold, then drag along a row of tiles with this number to set them in one stroke.": {
      "comment": "Message of the tip titled Paint Several Areas",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berühre und halte, dann zieh an einer Reihe von Steinchen mit dieser Zahl entlang, um sie in einem Zug zu setzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado y arrastra a lo largo de una hilera de teselas con este número para colocarlas de un solo trazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez et maintenez, puis faites glisser le long d’un rang de tesselles de ce numéro pour les poser d’un seul geste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca e tieni premuto, poi trascina lungo una fila di tessere con questo numero per posarle con un solo tratto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押ししてから、この番号のタイルの列に沿ってドラッグすると、ひと筆でまとめてはめられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길게 누른 다음 이 숫자의 타일 줄을 따라 드래그하면 한 번에 붙일 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd vast en sleep dan langs een rij steentjes met dit nummer om ze in één streek te leggen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e mantenha, depois arraste por uma fileira de pastilhas com este número para assentá-las num só traço."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住，然后沿着带有这个数字的一行嵌片拖动，一笔就能把它们都镶上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住後沿著標著這個數字的一排嵌片拖移，一筆就能全部鑲上。"
          }
        }
      }
    },
