    "library.receive.damaged": {
      "comment": "Alert message when a file opened as a painting someone sent can't be read",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist vielleicht beschädigt, oder sie ist kein Mosaik. Bitte die Person, die sie geschickt hat, sie noch einmal zu senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file may be damaged, or it isn’t a mosaic. Ask whoever sent it to send it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que este archivo esté dañado o que no sea un mosaico. Pide a quien te lo envió que vuelva a enviarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier est peut-être endommagé, ou ce n’est pas une mosaïque. Demandez à la personne qui l’a envoyé de le renvoyer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file potrebbe essere danneggiato, oppure non è un mosaico. Chiedi a chi te l’ha inviato di mandarlo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは壊れているか、モザイクではないようです。送ってくれた人に、もう一度送ってもらってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 손상됐거나 모자이크 파일이 아니에요. 보낸 사람에게 다시 보내 달라고 해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bestand is misschien beschadigd, of het is geen mozaïek. Vraag degene die het stuurde om het opnieuw te sturen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo pode estar danificado, ou não é um mosaico. Peça para quem enviou mandar de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件可能已损坏，或者它不是马赛克。请让发送者再发一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個檔案可能已損壞，或者不是馬賽克。請傳送的人再傳一次。"
          }
        }
      }
    },
    "library.receive.needsNewerApp": {
      "comment": "Alert message when a painting someone sent was made by a newer version of the app",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Mosaik wurde von einer neueren Version von Paint by Mosaic gesendet. Aktualisiere die App, um es zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This mosaic was sent from a newer version of Paint by Mosaic. Update the app to open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mosaico se envió desde una versión más reciente de Paint by Mosaic. Actualiza la app para abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette mosaïque a été envoyée depuis une version plus récente de Paint by Mosaic. Mettez l’app à jour pour l’ouvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo mosaico è stato inviato da una versione più recente di Paint by Mosaic. Aggiorna l’app per aprirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモザイクは新しいバージョンのPaint by Mosaicから送られています。開くにはAppをアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모자이크는 새 버전의 Paint by Mosaic에서 보낸 거예요. 열려면 앱을 업데이트하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit mozaïek is verstuurd vanuit een nieuwere versie van Paint by Mosaic. Werk de app bij om het te openen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mosaico foi enviado de uma versão mais nova do Paint by Mosaic. Atualize o app para abri-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这幅马赛克是从更新版本的 Paint by Mosaic 发来的。更新 App 后即可打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這幅馬賽克是從較新版本的 Paint by Mosaic 傳來的。請更新 App 以打開它。"
          }
        }
      }
    },
    "library.receive.saveFailed": {
      "comment": "Alert message when a painting someone sent can't be written to the library",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mosaik ließ sich auf diesem Gerät nicht sichern. Gib etwas Speicherplatz frei und öffne es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mosaic couldn’t be saved on this device. Free up some space and open it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el mosaico en este dispositivo. Libera espacio y vuelve a abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mosaïque n’a pas pu être enregistrée sur cet appareil. Libérez un peu d’espace et ouvrez-la à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile salvare il mosaico su questo dispositivo. Libera un po’ di spazio e aprilo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにモザイクを保存できませんでした。空き容量を増やしてから、もう一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
