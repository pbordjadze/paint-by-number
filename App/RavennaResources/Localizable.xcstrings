          "stringUnit": {
            "state": "translated",
            "value": "They get a blank copy of this mosaic to set. Your photo stays on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibirán una copia en blanco de este mosaico para colocarlo. Tu foto se queda en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La personne reçoit une copie vierge de cette mosaïque à poser. Votre photo reste sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riceve una copia vuota di questo mosaico da comporre. La tua foto resta su questo dispositivo."
