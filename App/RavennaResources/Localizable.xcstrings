    "Gold lays the picture’s background in gold smalti, as behind the figures at Ravenna.": {
      "comment": "Create preview: the line under the Ground choice",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gold legt den Hintergrund des Bildes in goldenen Smalten, wie hinter den Figuren in Ravenna."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oro coloca el fondo de la imagen en esmaltes de oro, como detrás de las figuras de Rávena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Or pose le fond de l’image en smalti d’or, comme derrière les figures de Ravenne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oro posa lo sfondo dell’immagine in smalti d’oro, come dietro le figure di Ravenna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「金」は、ラヴェンナの人物の背景のように、絵の背景を金のスマルトで組みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금은 라벤나의 인물들 뒤처럼 그림의 바탕을 금 스말티로 깔아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goud legt de achtergrond van de afbeelding in gouden smalti, zoals achter de figuren in Ravenna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouro assenta o fundo da imagem em esmaltes de ouro, como atrás das figuras de Ravena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“金色”会用金色玻璃嵌片铺设图片的背景，就像拉文纳那些人物身后一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「金色」會用金色琺瑯嵌片鋪滿圖的背景，就像拉溫納那些人像背後一樣。"
          }
        }
      }
    },
