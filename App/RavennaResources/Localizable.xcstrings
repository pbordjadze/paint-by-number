    "gallery.recovery.retry": {
      "comment": "Recovery screen text added after a failed regeneration attempt",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Neuerstellen hat nicht geklappt. Versuch es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regenerating didn’t work. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo regenerar. Vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recréation n’a pas abouti. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricreazione non è riuscita. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作り直せませんでした。もう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 만들지 못했어요. 다시 시도해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnieuw maken is niet gelukt. Probeer het nog eens."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível gerar de novo. Tente outra vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新生成没有成功。请再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新製作沒有成功。請再試一次。"
          }
        }
      }
    },
    "gallery.recovery.unreadable": {
      "comment": "Recovery screen text when a painting's files exist but couldn't be read (a passing storage error)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ließ sich gerade nicht öffnen. Nichts hat sich geändert: Geh zurück und versuch es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It couldn’t be opened just now. Nothing changed: go back and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir ahora mismo. No ha cambiado nada: vuelve atrás e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’a pas pu être ouvert pour l’instant. Rien n’a changé : revenez en arrière et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile aprirlo in questo momento. Nulla è cambiato: torna indietro e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今は開けませんでした。何も変わっていません。戻ってもう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 열 수 없었어요. 아무것도 바뀌지 않았으니, 돌아가서 다시 시도해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het kon zojuist niet worden geopend. Er is niets veranderd: ga terug en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abri-lo agora. Nada mudou: volte e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法打开它。什么都没有改变：返回后再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法打開它。什麼都沒有改變：請返回再試一次。"
          }
        }
      }
    },
