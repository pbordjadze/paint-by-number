    "settings.sky.footer": {
      "comment": "Footer of Settings › Sound, under its Music row while it is set to Auto (the other choices are Major and Minor). The arguments are the hours, as the painter's clock writes them: when major begins (6 AM) and when minor begins (7 PM)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto spielt die Melodie ab %1$@ in Dur und ab %2$@ in Moll, nach deiner Uhrzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto plays the tune in major from %1$@ and in minor from %2$@, your time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto toca la melodía en mayor desde las %1$@ y en menor desde las %2$@, según tu hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto joue la mélodie en majeur à partir de %1$@ et en mineur à partir de %2$@, à votre heure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto suona la melodia in maggiore dalle %1$@ e in minore dalle %2$@, secondo la tua ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」では、お使いの時刻で%1$@から長調、%2$@から短調のメロディが流れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동은 내 시간으로 %1$@부터 장조로, %2$@부터 단조로 선율을 연주해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto speelt de melodie in majeur vanaf %1$@ en in mineur vanaf %2$@, volgens jouw klok."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto toca a melodia em tom maior a partir das %1$@ e em tom menor a partir das %2$@, no seu horário."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”会按你的当地时间，从 %1$@ 起以大调演奏旋律，从 %2$@ 起以小调演奏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」會依你的時間，從 %1$@ 起以大調演奏，從 %2$@ 起以小調演奏。"
          }
        }
      }
    },
