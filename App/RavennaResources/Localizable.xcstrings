    "Your next free painting comes tomorrow.": {
      "comment": "Under the create flow's Start Painting, for a painting of the painter's own photo when no free painting is left before Unlimited Paintings is bought (one comes back each day)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein nächstes kostenloses Bild kommt morgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu próximo cuadro gratis llega mañana."
          }
        },
        "fr": {
