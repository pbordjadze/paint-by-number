          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com agradecimento aos museus e arquivos que compartilham estas imagens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
