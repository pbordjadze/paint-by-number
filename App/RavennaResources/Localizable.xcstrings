    "Double-tap the mosaic to zoom in. Pinch to zoom back out.": {
      "comment": "Message of the tip titled Zoom In on Small Areas; the page is the painting being painted",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe zweimal auf das Mosaik, um hineinzuzoomen. Zieh zwei Finger zusammen, um wieder herauszuzoomen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces el mosaico para acercarlo. Pellizca para alejarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois la mosaïque pour zoomer. Pincez pour revenir en arrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca due volte il mosaico per ingrandire. Avvicina le dita per tornare indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モザイクをダブルタップすると拡大します。ピンチで元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모자이크를 두 번 탭하면 확대돼요. 두 손가락을 오므리면 다시 축소돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik twee keer op het mozaïek om in te zoomen. Knijp om weer uit te zoomen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes no mosaico para dar zoom. Faça o gesto de pinça para afastar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连按两下马赛克即可放大。双指捏合可缩小回去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點兩下馬賽克即可放大，捏合即可縮小。"
          }
        }
      }
    },
    "Drag the divider to compare the photo and the mosaic. Pinch to look closer.": {
      "comment": "Message of the tip titled Compare Photo and Page, at the divider between the photo and the page in the New Painting preview",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh den Trenner, um Foto und Mosaik zu vergleichen. Zieh zwei Finger auseinander, um genauer hinzusehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el divisor para comparar la foto y el mosaico. Pellizca para verlo más de cerca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser le séparateur pour comparer la photo et la mosaïque. Pincez pour regarder de plus près."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina il divisore per confrontare la foto e il mosaico. Allarga le dita per guardare più da vicino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仕切りをドラッグして、写真とモザイクを比べましょう。ピンチで近くに寄れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구분선을 드래그해 사진과 모자이크를 비교해 보세요. 두 손가락을 벌리면 더 가까이 볼 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep de scheidingslijn om de foto en het mozaïek te vergelijken. Knijp om beter te kijken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste o divisor para comparar a foto e o mosaico. Use a pinça para ver mais de perto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动分隔线来对比照片和马赛克。双指张开可以看得更仔细。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移分隔線來比較照片和馬賽克。捏合可以看得更仔細。"
          }
        }
      }
    },
    "Draw a line, and the rows of tiles follow it.": {
      "comment": "Refine's hint under its controls: the Lines tool",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne eine Linie, und die Steinchenreihen folgen ihr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja una línea y las hileras de teselas la seguirán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracez un trait : les rangs de tesselles le suivent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna una linea, e le file di tessere la seguono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "線を描くと、タイルの列がそれに沿って並びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선을 그으면 타일 줄이 그 선을 따라가요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken een lijn, en de rijen steentjes volgen haar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe uma linha, e as fileiras de pastilhas a seguem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画一条线，一行行嵌片就会沿着它排列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫一條線，一排排嵌片就會沿著它排列。"
          }
        }
      }
    },
    "Drop to Create a Mosaic": {
