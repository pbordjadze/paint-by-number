    "Each mark gets its own comment.": {
      "comment": "Feedback's review sheet: footer under the list of marks, each with its close-up and a comment field",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Markierung bekommt ihren eigenen Kommentar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada marca tiene su propio comentario."
          }
        },
        "fr": {
