    "With thanks to the museums and archives that share these pictures.": {
      "comment": "Footer under the Pictures list in Acknowledgements",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Dank an die Museen und Archive, die diese Bilder teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con nuestro agradecimiento a los museos y archivos que comparten estas imágenes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci aux musées et aux archives qui partagent ces images."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie ai musei e agli archivi che condividono queste immagini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの絵を公開している美術館とアーカイブに感謝します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그림들을 나눠 주는 미술관과 기록 보관소에 감사드려요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
