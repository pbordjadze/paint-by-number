    "Lay any picture as a mosaic, then set it tile by tile.": {
      "comment": "Subheadline of the empty gallery",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege jedes Bild als Mosaik und setze es dann Steinchen für Steinchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte cualquier imagen en un mosaico y colócalo tesela a tesela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites de n’importe quelle image une mosaïque, puis posez-la tesselle par tesselle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma qualsiasi immagine in un mosaico, poi componilo tessera dopo tessera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どんな絵もモザイクに組んで、1枚ずつタイルをはめましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 그림이든 모자이크로 만들고, 타일을 하나씩 붙여 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg elke afbeelding als mozaïek, en zet het steentje voor steentje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assente qualquer imagem como mosaico, depois monte-o pastilha por pastilha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把任意一张图片铺成马赛克，然后一块一块地镶嵌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把任何圖片鋪排成馬賽克，再一片一片鑲上。"
          }
        }
      }
    },
