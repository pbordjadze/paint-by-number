    "gallery.recovery.mayRepaint": {
      "comment": "Recovery screen text added for a damaged painting the painter refined in an earlier version: regenerating it keeps their edits, but its paints are chosen again and may differ",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Änderungen werden wiederhergestellt, aber manche Farben fallen vielleicht anders aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your changes will be made again, but some of its colors may come out different."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus cambios se volverán a aplicar, pero puede que algunos de sus colores salgan distintos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos changements seront refaits, mais certaines de ses couleurs pourraient être un peu différentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue modifiche verranno rifatte, ma alcuni colori potrebbero risultare diversi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は作り直されますが、色がいくつか変わるかもしれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바꾼 내용은 다시 적용되지만, 일부 색이 다르게 나올 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wijzigingen worden opnieuw gemaakt, maar sommige kleuren kunnen anders uitvallen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas mudanças serão feitas de novo, mas algumas cores podem sair diferentes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的改动会重新应用，但有些颜色可能会和之前不一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的變更會重新套用，但有些顏色可能會不太一樣。"
          }
        }
      }
    },
    "Gives the mosaic a name for sharing and printing.": {
