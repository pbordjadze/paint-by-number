    "feedback.canvas.hint": {
      "comment": "VoiceOver hint of the painting while feedback is being drawn on it",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne auf das Mosaik, um zu zeigen, worum es in deinem Feedback geht. Zwei Finger bewegen und zoomen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw on the mosaic to show what your feedback is about. Two fingers move and zoom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja sobre el mosaico para mostrar a qué se refieren tus comentarios. Dos dedos mueven y hacen zoom."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez sur la mosaïque pour montrer ce que vos commentaires concernent. Deux doigts pour déplacer et zoomer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna sul mosaico per mostrare a cosa si riferisce il tuo feedback. Due dita per spostare e zoomare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックの内容を示すようにモザイクに描き込みます。2本指で移動とズーム。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모자이크 위에 그려서 피드백이 무엇에 관한 것인지 보여 주세요. 두 손가락으로 옮기고 확대해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken op het mozaïek om te laten zien waar je feedback over gaat. Twee vingers verschuiven en zoomen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe no mosaico para mostrar do que trata o seu feedback. Dois dedos movem e dão zoom."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在马赛克上标出你的反馈是关于哪里。双指可移动和缩放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在馬賽克上畫出你的意見回饋與哪裡有關。兩指可移動和縮放。"
          }
        }
      }
    },
