    "acknowledgements.polylabel.usage": {
      "comment": "What a credited third-party method or library is used for in the template engine (Polylabel); shown in Settings under Acknowledgements",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet den Punkt einer Region, der am weitesten von ihren Rändern entfernt ist; dort steht ihre Zahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds the point of a region farthest from its edges, where its number is placed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra el punto de una región más alejado de sus bordes, donde se coloca su número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve le point d’une région le plus éloigné de ses bords, où son numéro est placé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova il punto di una regione più lontano dai suoi bordi, dove si posiziona il numero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "番号を置く、領域の縁からいちばん遠い点を見つけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역의 가장자리에서 가장 먼 점을 찾아 그곳에 숫자를 놓아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vindt het punt van een gebied dat het verst van de randen ligt, waar het nummer komt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra o ponto de uma região mais distante das bordas, onde o número dela é colocado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找出区域中离边缘最远的点，用来放置数字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找出區域中離邊緣最遠的點，用來放置數字。"
          }
        }
      }
    },
    "acknowledgements.potrace.usage": {
      "comment": "What a credited third-party method or library is used for in the template engine (Potrace); shown in Settings under Acknowledgements",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht aus treppenförmigen Umrissen glatte Kurven."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns stair-stepped region outlines into smooth curves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte los contornos escalonados de las regiones en curvas suaves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme les contours en escalier des régions en courbes douces."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma i contorni a gradini delle regioni in curve morbide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "階段状の領域の輪郭を、なめらかな曲線にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계단처럼 각진 영역 윤곽을 매끄러운 곡선으로 바꿔요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt van trapsgewijze omtrekken van gebieden vloeiende bogen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforma os contornos serrilhados das regiões em curvas suaves."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把阶梯状的区域轮廓变成平滑的曲线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把呈階梯狀的區域輪廓變成平滑曲線。"
          }
        }
      }
    },
    "acknowledgements.rtv.usage": {
      "comment": "What a credited third-party method or library is used for in the template engine (Relative total variation); shown in Settings under Acknowledgements",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterscheidet Textur von Struktur, damit Gesichter und Kanten ihre Details behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells texture from structure, so faces and edges keep their detail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Distingue la textura de la estructura, para que las caras y los bordes conserven su detalle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distingue la texture de la structure, pour que les visages et les contours gardent leurs détails."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Distingue la texture dalla struttura, così volti e bordi conservano i dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質感と構造を見分けて、顔や輪郭の細部を残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질감과 구조를 구별해서, 얼굴과 가장자리의 디테일을 지켜요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderscheidt textuur van structuur, zodat gezichten en randen hun details houden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Distingue textura de estrutura, para que rostos e bordas mantenham os detalhes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区分纹理与结构，让面部和边缘保留细节。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分辨紋理與結構，讓臉孔和邊緣保留細節。"
          }
        }
      }
    },
    "acknowledgements.skeletonize.usage": {
      "comment": "What a credited third-party method or library is used for in Ravenna's mosaic engine (scikit-image's thinning table); shown in Settings under Acknowledgements",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdünnt die Umrisse eines Fotos zu den einzelnen Reihen, an denen seine Steinchen entlang gelegt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thins a photo’s outlines to the single rows its strands of tiles are laid along."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adelgaza los contornos de una foto hasta las hileras simples a lo largo de las que se colocan sus teselas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduit les contours d’une photo à des lignes d’un pixel, le long desquelles ses rangs de tesselles sont posés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assottiglia i contorni di una foto fino alle singole righe lungo cui si posano le file di tessere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の輪郭を1列の細さにし、タイルの列をそれに沿って並べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진의 윤곽을 한 줄 굵기로 가늘게 해서, 타일 줄이 그 위를 따라 놓이게 해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunt de omtrekken in een foto uit tot enkele rijen, waarlangs de rijen steentjes worden gelegd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Afina os contornos de uma foto até as fileiras únicas ao longo das quais os fios de pastilhas são assentados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把照片的轮廓细化成单行，一串串嵌片沿着它铺设。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把照片的輪廓細化成單列，讓一排排嵌片沿著它們鋪設。"
          }
        }
      }
    },
    "acknowledgements.splitmix.usage": {
      "comment": "What a credited third-party method or library is used for in the template engine (SplitMix64); shown in Settings under Acknowledgements",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorgt dafür, dass dasselbe Foto mit denselben Einstellungen immer dieselbe Vorlage ergibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Makes the same photo and settings always give the same template."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que la misma foto con los mismos ajustes dé siempre la misma plantilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait qu’une même photo avec les mêmes réglages donne toujours le même modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa sì che la stessa foto con le stesse impostazioni dia sempre lo stesso modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ写真と設定から、いつも同じ下絵ができるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 사진과 설정이면 언제나 같은 도안이 나오게 해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorgt dat dezelfde foto en instellingen altijd hetzelfde sjabloon geven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz com que a mesma foto e os mesmos ajustes sempre deem o mesmo modelo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让同样的照片和设置始终得到同样的底稿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓同一張照片和設定永遠產生相同的底稿。"
          }
        }
      }
    },
    "acknowledgements.zhangSuen.usage": {
      "comment": "What a credited third-party method or library is used for in Ravenna's mosaic engine (Zhang–Suen thinning); shown in Settings under Acknowledgements",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdünnt die Umrisse zu einzelnen Reihen, damit an jeder eine Reihe Steinchen entlangläuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thins the outlines to single rows, so a strand of tiles runs along each."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adelgaza los contornos hasta hileras simples, para que una hilera de teselas recorra cada una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduit les contours à des lignes d’un pixel, pour qu’un rang de tesselles suive chacune d’elles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assottiglia i contorni fino a singole righe, così lungo ognuna corre una fila di tessere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "輪郭を1列の細さにして、それぞれに沿ってタイルの列が並ぶようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윤곽을 한 줄 굵기로 가늘게 해서, 윤곽마다 타일 한 줄이 이어지게 해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunt de omtrekken uit tot enkele rijen, zodat er langs elk een rij steentjes loopt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Afina os contornos até fileiras únicas, para que um fio de pastilhas corra ao longo de cada uma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把轮廓细化成单行，让一串嵌片沿着每一行铺设。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把輪廓細化成單列，讓每條輪廓都有一排嵌片沿著它延伸。"
          }
        }
      }
    },
