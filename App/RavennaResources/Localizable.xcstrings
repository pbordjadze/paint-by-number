        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的檔案已損壞。可以從它的照片重新製作。"
          }
        }
      }
    },
    "gallery.recovery.damaged.regenerableFresh": {
      "comment": "Recovery screen text for a damaged painting that has paint on it and can be regenerated from its photo",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist beschädigt. Das Mosaik lässt sich aus seinem Bild neu legen, aber die gesetzten Steinchen lassen sich nicht retten: Es beginnt neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its file is damaged. It can be laid again from its picture, but the tiles you set can’t be saved: it will start fresh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su archivo está dañado. Se puede volver a componer a partir de su imagen, pero las teselas que colocaste no se pueden conservar: empezará de cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son fichier est endommagé. Elle peut être recomposée à partir de son image, mais les tesselles posées ne peuvent pas être conservées : elle repartira de zéro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo file è danneggiato. Si può ricomporre dalla sua immagine, ma le tessere posate non si possono salvare: ripartirà da capo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが壊れています。元の絵から組み直せますが、はめたタイルは残せないので、最初からになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 손상됐어요. 그림으로 다시 만들 수 있지만, 붙인 타일은 지킬 수 없어서 처음부터 시작해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand is beschadigd. Het kan opnieuw worden gelegd uit de afbeelding, maar de steentjes die je legde kunnen niet worden bewaard: het begint opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo está danificado. Ele pode ser assentado de novo a partir da imagem, mas as pastilhas que você assentou não podem ser salvas: ele vai recomeçar do zero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的文件已损坏。可以根据它的图片重新铺设，但你镶好的嵌片无法保留：它将从头开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的檔案已損壞。可以從它的圖片重新鋪排，但你鑲上的嵌片無法保留：它會重新開始。"
          }
        }
      }
    },
    "gallery.recovery.damaged.unavailable": {
      "comment": "Recovery screen text for a damaged painting whose original photo is gone",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist beschädigt, und das Foto ist nicht mehr da, deshalb lässt sich das Bild nicht neu erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its file is damaged, and its photo is gone, so it can’t be made again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su archivo está dañado y su foto ya no está, así que no se puede volver a hacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son fichier est endommagé et sa photo a disparu : il ne peut pas être recréé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo file è danneggiato, e la sua foto non c’è più, quindi non si può ricreare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが壊れていて写真もないため、作り直せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 손상됐고 사진도 없어서 다시 만들 수 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand is beschadigd en de foto is weg, dus het kan niet opnieuw worden gemaakt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo está danificado, e a foto não existe mais, então ele não pode ser feito de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的文件已损坏，照片也不在了，所以无法重新生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的檔案已損壞，照片也不在了，所以無法重新製作。"
          }
        }
      }
    },
    "gallery.recovery.newer.titled": {
      "comment": "Recovery screen text for a painting made by a newer app version; the argument is the painting's title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wurde mit einer neueren Version von Paint by Mosaic erstellt. Aktualisiere die App, um weiterzusetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” was made with a newer version of Paint by Mosaic. Update the app to keep setting it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» se hizo con una versión más reciente de Paint by Mosaic. Actualiza la app para seguir colocándolo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » a été créée avec une version plus récente de Paint by Mosaic. Mettez l’app à jour pour continuer à la poser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” è stato creato con una versione più recente di Paint by Mosaic. Aggiorna l’app per continuare a comporlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”は新しいバージョンのPaint by Mosaicで作られています。続けてはめるにはAppをアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 모자이크는 새 버전의 Paint by Mosaic으로 만들어졌어요. 계속 붙이려면 앱을 업데이트하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is gemaakt met een nieuwere versie van Paint by Mosaic. Werk de app bij om verder te leggen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” foi feito numa versão mais nova do Paint by Mosaic. Atualize o app para continuar assentando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是用更新版本的 Paint by Mosaic 制作的。更新 App 后即可继续镶嵌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」是用較新版本的 Paint by Mosaic 製作的。請更新 App 以繼續鑲嵌。"
          }
        }
      }
    },
