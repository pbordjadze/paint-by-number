    "acknowledgements.oklab.usage": {
      "comment": "What a credited third-party method or library is used for in the template engine (OKLab); shown in Settings under Acknowledgements",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleicht Farben so, wie das Auge es tut, wenn die Palette gewählt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compares colors the way the eye does when choosing the palette."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara los colores como lo hace el ojo al elegir la paleta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare les couleurs comme le fait l’œil, pour choisir la palette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta i colori come fa l’occhio quando sceglie la tavolozza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パレットを選ぶとき、目と同じように色を比べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔레트를 고를 때 눈이 보는 방식대로 색을 비교해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijkt kleuren zoals het oog dat doet bij het kiezen van het palet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara as cores como o olho faz, ao escolher a paleta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑选调色板时，像人眼一样比较颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇調色盤時，以人眼的方式比較顏色。"
          }
        }
      }
    },
