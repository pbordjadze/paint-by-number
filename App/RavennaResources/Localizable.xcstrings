    "Fewer or More Pieces": {
      "comment": "Title of the tip at the Colors slider of the New Painting preview, shown on the second page made",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger oder mehr Steinchen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos o más piezas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins ou plus de pièces"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meno o più tessere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピースを少なく、または多く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조각을 줄이거나 늘리기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minder of meer stukjes"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos ou mais peças"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嵌片少一些还是多一些"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嵌片少一點或多一點"
          }
        }
      }
    },
    "Fewer pieces make a bolder mosaic, quicker to set. More make a finer one.": {
      "comment": "Message of the tip titled Fewer or More Areas, about the Colors and Detail sliders of the New Painting preview; a page is a painting",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger Steinchen ergeben ein kräftigeres Mosaik, schneller gesetzt. Mehr ergeben ein feineres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos piezas dan un mosaico más audaz, más rápido de colocar. Más piezas, uno más fino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins de pièces donnent une mosaïque plus franche, plus rapide à poser. Davantage en donnent une plus fine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meno tessere danno un mosaico più deciso, più rapido da posare. Di più lo rendono più fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピースを少なくすると力強いモザイクになり、早くはめ終わります。多くすると細やかなモザイクになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조각이 적으면 더 대담하고 빨리 붙일 수 있는 모자이크가 되고, 많으면 더 섬세한 모자이크가 돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minder stukjes geven een krachtiger mozaïek, sneller gelegd. Meer geven een fijner mozaïek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos peças fazem um mosaico mais ousado, mais rápido de assentar. Mais fazem um mais fino."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嵌片少，马赛克更醒目，镶得也快。嵌片多，马赛克更精细。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嵌片少，馬賽克更大膽，鑲起來也更快。嵌片多，則會更細緻。"
          }
        }
      }
    },
