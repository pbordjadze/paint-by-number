<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's entitlements in an App Store or TestFlight build (testflight.yml signs the archive
     with them before the export): the app group it shares with its widgets and stickers
     (`Outside.entitlements`, which the extensions get) and Paint Together's SharePlay. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.pbordjadze.paintbynumber</string>
	</array>
	<key>com.apple.developer.group-session</key>
	<true/>
</dict>
</plist>
