<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's entitlements in the nightly (testflight.yml signs a nightly's archive with them in
     place of AppStore.entitlements): the App Store's, and Apple Pay for One Big Sheet, which only
     the SideStore features have (painting-company row 380). The merchant id is
     BigSheetApplePay.merchant's. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.pbordjadze.paintbynumber</string>
	</array>
	<key>com.apple.developer.group-session</key>
	<true/>
	<key>com.apple.developer.in-app-payments</key>
	<array>
		<string>merchant.com.paulbordjadze.paintbymoonlight</string>
	</array>
</dict>
</plist>
