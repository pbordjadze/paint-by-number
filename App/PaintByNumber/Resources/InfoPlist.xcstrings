    "Image" : {
      "comment" : "Name of the document type the app declares for images, shown by the system when a photo is opened in Paint by Moonlight from the share sheet or Files (CFBundleTypeName in Config/Info.plist)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Image"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Shown in the system alert that asks permission to use the camera (Take Photo in the create flow)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paint by Moonlight uses the camera to take a photo you can turn into a paint-by-numbers picture. The photo stays on your device."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Shown in the system alert that asks permission to add pictures to the photo library (Save to Photos)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paint by Moonlight saves a finished painting to your photo library when you choose Save to Photos."
          }
        }
      }
    }
  },
  "version" : "1.0"
