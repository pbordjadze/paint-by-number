    "Draw the lead over your photo. Every shape you close becomes a piece of glass." : {
      "comment" : "Stained Glass, the Lead screen: hint before the first line (lead is the metal strip between pieces of glass)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichne das Blei über dein Foto. Jede Form, die du schließt, wird ein Stück Glas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja el plomo sobre tu foto. Cada forma que cierres será una pieza de vidrio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessinez les plombs sur votre photo. Chaque forme fermée devient une pièce de verre."
