    "refine.changes.none" : {
      "comment" : "VoiceOver value of the Refine button and the Refine screen's picture before anything was refined",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No changes"
          }
        }
      }
    },
    "refine.hint.curve" : {
      "comment" : "Refine screen: how the Shapes tool's Curve works (a first drag places the curve's ends, a second bends it through the finger), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag from one end of the curve to the other, then drag to bend it. Two fingers zoom and move."
          }
        }
      }
    },
    "refine.hint.curve.bend" : {
      "comment" : "Refine screen: the Shapes tool's Curve once its ends are placed: a drag bends it through the finger, a tap keeps it a straight line",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to bend the curve, or tap to keep it straight."
          }
        }
      }
    },
    "refine.hint.eraser" : {
      "comment" : "Refine screen: how the Eraser works (it takes out exactly the parts of lines it touches), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rub out just what you touch, or tap to erase a spot. Two fingers zoom and move."
          }
        }
      }
    },
    "refine.hint.fill" : {
      "comment" : "Refine screen: how the Fill tool works (a tap makes the closed shape of the drawing under it an area of its own, painted the photo's color where it was tapped; a tap in a filled area clears it), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap inside a closed shape to make it an area of its own, in the photo’s color there. Tap it again to clear it. Two fingers zoom and move."
          }
        }
      }
    },
    "refine.hint.line" : {
      "comment" : "Refine screen: how the Shapes tool's Line works (a drag draws a straight line from where it starts to where it ends), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to draw a straight line. Two fingers zoom and move."
          }
        }
      }
    },
    "refine.hint.oval" : {
      "comment" : "Refine screen: how the Shapes tool's Oval works (a drag spans the box the oval fills), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag across to draw an oval. Two fingers zoom and move."
          }
        }
      }
    },
    "refine.hint.pen" : {
      "comment" : "Refine screen: how the Pen works (it draws lines into the painting's drawing just where they are drawn), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw lines exactly as you draw them. Two fingers zoom and move, and a two‑finger tap undoes."
          }
        }
      }
    },
    "refine.hint.rectangle" : {
      "comment" : "Refine screen: how the Shapes tool's Rectangle works (a drag spans the rectangle from one corner to the opposite one), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag from corner to corner to draw a rectangle. Two fingers zoom and move."
          }
        }
      }
    },
    "refine.hint.smartEraser" : {
      "comment" : "Refine screen: how the Smart Eraser works (it takes lines out of the painting's drawing; a tap takes a whole line), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rub lines out, or tap a line to erase all of it. Two fingers zoom and move."
          }
        }
      }
    },
    "refine.hint.text" : {
      "comment" : "Refine screen: how the Text tool works (lines of text in the photo are drawn as writing), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a line of text to keep or ignore it, or drag across a line the app missed."
          }
        }
      }
    },
    "refine.note.left" : {
      "comment" : "Refine screen toast after the sliders or a text correction made the template again: how many of the painter's edits no longer apply to it; the argument is the count",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld edit no longer fits the new drawing and was left out."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld edits no longer fit the new drawing and were left out."
                }
              }
            }
          }
        }
      }
    },
    "refine.note.notDrawn" : {
      "comment" : "Refine screen toast: a line the painter drew could not be added to the drawing (it doubled back on itself, or lay too close to other lines); nothing changed",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That line couldn’t be drawn there."
          }
        }
      }
    },
    "refine.note.notErased" : {
      "comment" : "Refine screen toast: an erasure the painter made could not be carried out; nothing changed",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That couldn’t be erased."
          }
        }
      }
    },
    "refine.note.notFilled" : {
      "comment" : "Refine screen toast: a Fill tap could not make its shape an area (no room for the number of its paint); nothing changed",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That shape couldn’t be filled."
          }
        }
      }
    },
    "refine.note.notSplit" : {
      "comment" : "Refine screen toast: a Color Splitter stroke could not divide an area's color (it closed off no area, or both sides would have kept the same paint); nothing changed",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That area couldn’t be split there."
          }
        }
      }
    },
    "refine.note.tooSmall" : {
      "comment" : "Refine screen toast: a shape the painter closed with a line has no room for a number, so it did not become an area of its own; the line stays",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That shape is too small for a number."
          }
        }
      }
    },
