    },
    "In the margin" : {
      "comment" : "The Marginarium: heading of the card of margin notes that opens under the highlighted words a reader tapped",
      "extractionState" : "manual"
    },
    "lamp.intro" : {
      "comment" : "The Marginarium, Who is Who: the line at the top of the page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
