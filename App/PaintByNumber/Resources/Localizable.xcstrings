    "Turn any photo into a numbered canvas, then bring it to life one color at a time." : {
      "comment" : "Subheadline of the empty gallery",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwandle jedes Foto in eine nummerierte Leinwand und erweck es dann Farbe für Farbe zum Leben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte cualquier foto en un lienzo numerado y dale vida color a color."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transformez n’importe quelle photo en toile numérotée, puis donnez-lui vie, une couleur à la fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasforma qualsiasi foto in una tela numerata, poi dalle vita un colore alla volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どんな写真も番号つきのキャンバスにして、1色ずつ命を吹き込みましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 사진이든 숫자가 적힌 캔버스로 바꾸고, 한 색씩 칠하며 살아나게 해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak van elke foto een genummerd doek, en breng het kleur voor kleur tot leven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transforme qualquer foto numa tela numerada, e dê vida a ela uma cor de cada vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把任意一张照片变成带数字的画布，然后一次一个颜色，让它渐渐鲜活起来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把任何照片變成有編號的畫布，再一次一個顏色，讓它活起來。"
          }
        }
      }
    },
    "Undo" : {
