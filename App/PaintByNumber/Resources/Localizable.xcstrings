    "library.receive.damaged" : {
      "comment" : "Alert message when a file opened as a painting someone sent can't be read",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei ist vielleicht beschädigt, oder sie ist kein Bild. Bitte die Person, die sie geschickt hat, sie noch einmal zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file may be damaged, or it isn’t a painting. Ask whoever sent it to send it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que este archivo esté dañado o que no sea un cuadro. Pide a quien te lo envió que vuelva a enviarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier est peut-être endommagé, ou ce n’est pas un tableau. Demandez à la personne qui l’a envoyé de le renvoyer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo file potrebbe essere danneggiato, oppure non è un quadro. Chiedi a chi te l’ha inviato di mandarlo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルは壊れているか、絵ではないようです。送ってくれた人に、もう一度送ってもらってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일이 손상됐거나 그림 파일이 아니에요. 보낸 사람에게 다시 보내 달라고 해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit bestand is misschien beschadigd, of het is geen schilderij. Vraag degene die het stuurde om het opnieuw te sturen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este arquivo pode estar danificado, ou não é uma pintura. Peça para quem enviou mandar de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个文件可能已损坏，或者它不是画作。请让发送者再发一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個檔案可能已損壞，或者不是畫作。請傳送的人再傳一次。"
          }
        }
      }
    },
    "library.receive.needsNewerApp" : {
      "comment" : "Alert message when a painting someone sent was made by a newer version of the app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Bild wurde von einer neueren Version von Paint by Moonlight gesendet. Aktualisiere die App, um es zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This painting was sent from a newer version of Paint by Moonlight. Update the app to open it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este cuadro se envió desde una versión más reciente de Paint by Moonlight. Actualiza la app para abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce tableau a été envoyé depuis une version plus récente de Paint by Moonlight. Mettez l’app à jour pour l’ouvrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo quadro è stato inviato da una versione più recente di Paint by Moonlight. Aggiorna l’app per aprirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この絵は新しいバージョンのPaint by Moonlightから送られています。開くにはAppをアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 그림은 새 버전의 Paint by Moonlight에서 보낸 거예요. 열려면 앱을 업데이트하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit schilderij is verstuurd vanuit een nieuwere versie van Paint by Moonlight. Werk de app bij om het te openen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta pintura foi enviada de uma versão mais nova do Paint by Moonlight. Atualize o app para abri-la."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这幅画作是从更新版本的 Paint by Moonlight 发来的。更新 App 后即可打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這幅畫作是從較新版本的 Paint by Moonlight 傳來的。請更新 App 以打開它。"
          }
        }
      }
    },
    "library.receive.saveFailed" : {
      "comment" : "Alert message when a painting someone sent can't be written to the library",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bild ließ sich auf diesem Gerät nicht sichern. Gib etwas Speicherplatz frei und öffne es noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The painting couldn’t be saved on this device. Free up some space and open it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar el cuadro en este dispositivo. Libera espacio y vuelve a abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tableau n’a pas pu être enregistré sur cet appareil. Libérez un peu d’espace et ouvrez-le à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile salvare il quadro su questo dispositivo. Libera un po’ di spazio e aprilo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスに絵を保存できませんでした。空き容量を増やしてから、もう一度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에 그림을 저장할 수 없었어요. 저장 공간을 조금 비운 다음 다시 열어 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het schilderij kon niet op dit apparaat worden bewaard. Maak wat ruimte vrij en open het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível salvar a pintura neste aparelho. Libere um pouco de espaço e abra de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法在这台设备上存储这幅画作。请释放一些空间后再打开它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法在這部裝置上儲存這幅畫作。請釋放一些空間，然後再打開一次。"
          }
        }
      }
    },
