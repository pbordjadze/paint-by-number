    "gallery.recovery.unreadable" : {
      "comment" : "Recovery screen text when a painting's files exist but couldn't be read (a passing storage error)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ließ sich gerade nicht öffnen. Nichts hat sich geändert: Geh zurück und versuch es noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It couldn’t be opened just now. Nothing changed: go back and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir ahora mismo. No ha cambiado nada: vuelve atrás e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’a pas pu être ouvert pour l’instant. Rien n’a changé : revenez en arrière et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile aprirlo in questo momento. Nulla è cambiato: torna indietro e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今は開けませんでした。何も変わっていません。戻ってもう一度試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 열 수 없었어요. 아무것도 바뀌지 않았으니, 돌아가서 다시 시도해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
