    "send.explanation.drawingOnly" : {
      "comment" : "Send Template's note with the Original Photo switch off",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du schickst eine leere Kopie dieses Blatts zum Malen, mit deinen Änderungen an der Zeichnung. Dein Foto bleibt auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They get a blank copy of this page to paint, your changes to the drawing included. Your photo stays on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibirán una copia en blanco de esta página para pintarla, con tus cambios en el dibujo incluidos. Tu foto se queda en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La personne reçoit une copie vierge de cette page à peindre, vos changements au dessin compris. Votre photo reste sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riceve una copia vuota di questa pagina da dipingere, con le tue modifiche al disegno. La tua foto resta su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手には、線の変更も含めて、このページの白紙のコピーが届きます。写真はこのデバイスに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 페이지의 빈 사본을 받아 칠할 수 있어요. 그림에서 바꾼 내용도 들어 있어요. 사진은 이 기기에만 남아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze krijgen een lege kopie van dit blad om te schilderen, met je wijzigingen aan de tekening. Je foto blijft op dit apparaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pessoa recebe uma cópia em branco desta página para pintar, com as suas mudanças no desenho. Sua foto fica neste aparelho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对方会收到这一页的空白副本来涂色，包括你对线稿的改动。你的照片会留在这台设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對方會收到這一頁的空白副本來上色，包含你對線稿的變更。你的照片會留在這部裝置上。"
          }
        }
      }
    },
