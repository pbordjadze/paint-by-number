    "Tap + to turn one of your photos, or a sample, into a page to paint." : {
      "comment" : "Message of the tip titled Make Your Own Page, at the gallery’s + (New Painting) button",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf +, um eines deiner Fotos oder ein Beispiel in ein Blatt zum Malen zu verwandeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca + para convertir una de tus fotos, o un ejemplo, en una página para pintar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez + pour faire d’une de vos photos, ou d’un exemple, une page à peindre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca + per trasformare una tua foto, o un esempio, in una pagina da dipingere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "＋をタップすると、自分の写真やサンプルを塗れるページにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+를 탭해 내 사진이나 샘플을 칠할 페이지로 만들어 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op + om een van je foto’s, of een voorbeeld, een blad te maken om te schilderen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em + para transformar uma das suas fotos, ou um exemplo, numa página para pintar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点 + 号，把你的照片或示例变成一页待涂的画。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下 +，把你的照片或範例變成一頁可以上色的畫。"
          }
        }
      }
    },
    "Tap a page in Ready to Paint to begin. Nothing needs setting up first." : {
      "comment" : "Message of the tip titled A Page Is Waiting, inline in the gallery’s Ready to Paint section; Ready to Paint is that section’s title",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe unter „Bereit zum Malen“ auf ein Blatt, um zu beginnen. Du musst vorher nichts einrichten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una página en Listos para pintar para empezar. No hace falta preparar nada antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une page dans Prêts à peindre pour commencer. Rien à régler avant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca una pagina in Pronti da dipingere per iniziare. Non c’è niente da preparare prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「塗る準備ができました」のページをタップすれば始められます。先に設定することは何もありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "칠할 준비 완료에서 페이지를 탭하면 바로 시작해요. 미리 설정할 건 없어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een blad in Klaar om te schilderen om te beginnen. Je hoeft eerst niets in te stellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque numa página em Prontas para pintar para começar. Não é preciso ajustar nada antes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“可以开始涂了”中轻点一页即可开始。什么都不用先设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下「等你上色」中的任一頁就能開始，不需要先做任何設定。"
          }
        }
      }
    },
    "Tap the selected color again, or the lightbulb, to be shown an area to paint." : {
      "comment" : "Message of the tip titled Can’t Find It?; the lightbulb is the painting screen’s Hint button",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe noch einmal auf die gewählte Farbe oder auf die Glühbirne, dann wird dir eine Fläche zum Malen gezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca otra vez el color seleccionado, o la bombilla, para que te muestre una zona que pintar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez à nouveau la couleur choisie, ou l’ampoule, pour voir une zone à peindre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca di nuovo il colore selezionato, o la lampadina, per vedere un’area da dipingere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んでいる色をもう一度タップするか、電球をタップすると、塗るエリアを教えてくれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 색이나 전구를 한 번 더 탭하면 칠할 영역을 보여 줘요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik nog eens op de gekozen kleur, of op het lampje, om een vlak te zien dat je kunt schilderen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque de novo na cor selecionada, ou na lâmpada, para ver uma área para pintar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再次轻点选中的颜色，或者轻点灯泡，就会显示一个要涂的区域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再點一下選取的顏色，或點燈泡，就會顯示一個可以上色的區塊。"
          }
        }
      }
    },
