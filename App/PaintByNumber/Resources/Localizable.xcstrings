    "paint.zen.on" : {
      "comment" : "Painting screen: a toast for a few seconds after Zen Mode is turned on in the More menu, saying what it does to the view",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zen-Modus ist an: Nach jedem Füllen gleitet das Blatt zur nächsten Fläche deiner Farbe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zen Mode is on: after each fill, the page glides to the next area of your color."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Modo Zen está activado: después de cada relleno, la página se desliza hasta la siguiente zona de tu color."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode zen est activé : après chaque remplissage, la page glisse jusqu’à la zone suivante de votre couleur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Modalità Zen è attiva: dopo ogni riempimento, la pagina scivola all’area successiva del tuo colore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "禅モードがオンです。塗るたびに、ページが同じ色の次のエリアへすべるように移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "젠 모드가 켜졌어요. 한 곳을 칠할 때마다 페이지가 같은 색의 다음 영역으로 부드럽게 옮겨 가요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zen-modus staat aan: na elke vulling glijdt het blad naar het volgende vlak van je kleur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Modo Zen está ativado: depois de cada preenchimento, a página desliza até a próxima área da sua cor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "禅模式已打开：每次填色后，画页会平滑地移到你这个颜色的下一个区域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「禪模式」已開啟：每次上色後，頁面會滑到你這個顏色的下一個區塊。"
          }
        }
      }
    },
