        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真の上に鉛の線を描きます。閉じた形がそれぞれガラスの一片になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 위에 납선을 그려요. 닫힌 모양마다 유리 한 조각이 돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teken het lood over je foto. Elke vorm die je sluit, wordt een stuk glas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
