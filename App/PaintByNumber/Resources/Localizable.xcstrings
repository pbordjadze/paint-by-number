    "refine.smoothing.hint" : {
      "comment" : "Refine screen, the Pen's options: VoiceOver hint of Smoothing, a slider from off to full (Procreate calls it StreamLine)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleicht eine zittrige Linie aus: Die Linie folgt deinem Finger mit etwas Abstand. Aus zeichnet genau, wie du zeichnest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evens out a wobbly line: the line trails your finger a little. Off draws exactly as you draw."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iguala una línea temblorosa: la línea sigue a tu dedo con un poco de retraso. Desactivado, dibuja exactamente como dibujas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
