    "acknowledgements.polylabel.usage" : {
      "comment" : "What a credited third-party method or library is used for in the template engine (Polylabel); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findet den Punkt einer Region, der am weitesten von ihren Rändern entfernt ist; dort steht ihre Zahl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds the point of a region farthest from its edges, where its number is placed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra el punto de una región más alejado de sus bordes, donde se coloca su número."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouve le point d’une région le plus éloigné de ses bords, où son numéro est placé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova il punto di una regione più lontano dai suoi bordi, dove si posiziona il numero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "番号を置く、領域の縁からいちばん遠い点を見つけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영역의 가장자리에서 가장 먼 점을 찾아 그곳에 숫자를 놓아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vindt het punt van een gebied dat het verst van de randen ligt, waar het nummer komt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontra o ponto de uma região mais distante das bordas, onde o número dela é colocado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找出区域中离边缘最远的点，用来放置数字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找出區域中離邊緣最遠的點，用來放置數字。"
          }
        }
      }
    },
    "acknowledgements.potrace.usage" : {
      "comment" : "What a credited third-party method or library is used for in the template engine (Potrace); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht aus treppenförmigen Umrissen glatte Kurven."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns stair-stepped region outlines into smooth curves."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte los contornos escalonados de las regiones en curvas suaves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transforme les contours en escalier des régions en courbes douces."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasforma i contorni a gradini delle regioni in curve morbide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "階段状の領域の輪郭を、なめらかな曲線にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계단처럼 각진 영역 윤곽을 매끄러운 곡선으로 바꿔요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt van trapsgewijze omtrekken van gebieden vloeiende bogen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transforma os contornos serrilhados das regiões em curvas suaves."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把阶梯状的区域轮廓变成平滑的曲线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把呈階梯狀的區域輪廓變成平滑曲線。"
          }
        }
      }
    },
    "acknowledgements.rtv.usage" : {
      "comment" : "What a credited third-party method or library is used for in the template engine (Relative total variation); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterscheidet Textur von Struktur, damit Gesichter und Kanten ihre Details behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tells texture from structure, so faces and edges keep their detail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue la textura de la estructura, para que las caras y los bordes conserven su detalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue la texture de la structure, pour que les visages et les contours gardent leurs détails."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue la texture dalla struttura, così volti e bordi conservano i dettagli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "質感と構造を見分けて、顔や輪郭の細部を残します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "질감과 구조를 구별해서, 얼굴과 가장자리의 디테일을 지켜요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderscheidt textuur van structuur, zodat gezichten en randen hun details houden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue textura de estrutura, para que rostos e bordas mantenham os detalhes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "区分纹理与结构，让面部和边缘保留细节。"
