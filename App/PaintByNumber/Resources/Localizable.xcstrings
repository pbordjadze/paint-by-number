    "Replay Painting plays your page back from the first fill." : {
      "comment" : "Message of the tip titled Watch It Again; Replay Painting plays a finished painting back from its first fill",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
