            "state" : "translated",
            "value" : "The end. Colophon, Claude's moth, says goodnight."
          }
        }
      }
    },
    "marginarium.goodnight.pip" : {
      "comment" : "The Marginarium: under the last line of Codex's chapter, beside its pet; Pip is the pet's name",
