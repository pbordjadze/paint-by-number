    "feedback.announcement.started" : {
      "comment" : "VoiceOver announcement as the painting screen switches to giving feedback; Next is the button that opens the sheet to write and send it",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedback. Zeichne auf das Bild, um zu zeigen, worum es geht, und wähle dann Weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedback. Draw on the painting to show what it’s about, then choose Next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comentarios. Dibuja sobre el cuadro para mostrar a qué se refieren y luego elige Siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commentaires. Dessinez sur le tableau pour montrer de quoi il s’agit, puis choisissez Suivant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedback. Disegna sul quadro per mostrare di cosa si tratta, poi scegli Avanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィードバック。何についてか、絵に描き込んで示してから「次へ」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피드백. 그림 위에 그려서 무엇에 관한 것인지 보여 준 다음, 다음을 고르세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedback. Teken op het schilderij om te laten zien waar het over gaat, en kies dan Volgende."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedback. Desenhe na pintura para mostrar do que se trata, depois escolha Seguinte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反馈。在画作上标出你想说的地方，然后选择“下一步”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意見回饋。在畫作上畫出你想說的地方，然後選擇「下一步」。"
          }
        }
      }
    },
