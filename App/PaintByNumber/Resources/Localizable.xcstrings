          }
        }
      }
    },
    "refine.hint.eyedropper" : {
      "comment" : "Refine screen: how the Eyedropper works (a tap, or a touch and hold with any tool, picks the paint of the area under it, or the photo's color where the photo shows most), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine Fläche, um ihre Farbe zur aktuellen zu machen, oder berühre und halte mit jedem Werkzeug. Wo das Foto durchscheint, nimmt sie den Farbton des Fotos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap an area to make its paint the current paint, or touch and hold with any tool. Where the photo shows, it picks the photo’s color."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una zona para que su pintura sea la pintura actual, o mantén el dedo quieto con cualquier herramienta. Donde se ve la foto, toma el color de la foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une zone pour faire de sa peinture la peinture actuelle, ou touchez et maintenez avec n’importe quel outil. Là où la photo apparaît, c’est sa couleur qui est prise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un’area per rendere il suo colore quello attuale, o tocca e tieni premuto con qualsiasi strumento. Dove si vede la foto, prende la tinta della foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エリアをタップするとその絵の具が今の絵の具になります。どのツールでも長押しで同じことができます。写真が見えている所では写真の色を拾います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영역을 탭해 그 물감을 지금 물감으로 삼거나, 어떤 도구로든 길게 누르세요. 사진이 보이는 곳에서는 사진의 색을 집어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een vlak om de verf ervan de huidige verf te maken, of houd vast met elk gereedschap. Waar de foto te zien is, pakt hij de kleur van de foto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque numa área para tornar a tinta dela a tinta atual, ou toque e mantenha com qualquer ferramenta. Onde a foto aparece, ele pega a cor da foto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点一个区域，把它的颜料设为当前颜料；用任何工具时按住也可以。照片显示出来的地方，会取照片的颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下區塊，讓它的顏料成為目前的顏料，或用任何工具按住。在照片透出的地方，會拾取照片的顏色。"
          }
        }
      }
    },
    "refine.hint.merge" : {
