    "refine.hint.cellEdge" : {
      "comment" : "Refine screen: how Cell Edge works (a stroke divides an area where it goes, drawing no line; both parts keep their paint until painted), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh über eine Fläche, um sie ohne Linie in zwei zu teilen. Beide Teile behalten die Farbe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw across an area to divide it in two with no line. Both parts keep the paint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja a través de una zona para dividirla en dos sin línea. Las dos partes conservan la pintura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tracez en travers d’une zone pour la diviser en deux sans trait. Les deux parties gardent la peinture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traccia attraverso un’area per dividerla in due senza linea. Entrambe le parti mantengono il colore."
