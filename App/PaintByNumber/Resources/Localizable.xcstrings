          }
        }
      }
    },
    "Draw a closed shape, then tap inside it with Make Cell to give it a number of its own." : {
      "comment" : "Message of the tip titled Make a Shape Its Own, about Refine’s Make Cell tool",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
