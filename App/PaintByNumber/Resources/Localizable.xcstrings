          "stringUnit" : {
            "state" : "translated",
            "value" : "Its file is damaged. It can be made again from its photo, but its paint can’t be saved: it will start fresh."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su archivo está dañado. Se puede volver a hacer a partir de su foto, pero su pintura no se puede conservar: empezará de cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son fichier est endommagé. Il peut être recréé à partir de sa photo, mais sa peinture ne peut pas être conservée : il repartira de zéro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suo file è danneggiato. Si può ricreare dalla sua foto, ma il colore steso non si può salvare: ripartirà da capo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルが壊れています。写真から作り直せますが、塗った絵の具は残せないので、最初からになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일이 손상됐어요. 사진으로 다시 만들 수 있지만, 칠한 물감은 지킬 수 없어서 처음부터 시작해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het bestand is beschadigd. Het kan opnieuw worden gemaakt uit de foto, maar de verf kan niet worden bewaard: het begint opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo está danificado. Ela pode ser feita de novo a partir da foto, mas a tinta não pode ser salva: ela vai recomeçar do zero."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的文件已损坏。可以根据它的照片重新生成，但涂过的颜料无法保留：它将从头开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的檔案已損壞。可以從它的照片重新製作，但上過的顏色無法保留：它會重新開始。"
          }
        }
      }
    },
    "gallery.recovery.damaged.unavailable" : {
      "comment" : "Recovery screen text for a damaged painting whose original photo is gone",
