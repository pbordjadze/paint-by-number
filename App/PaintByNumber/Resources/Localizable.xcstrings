    },
    "marginarium.marginarium.block.e45b9954d81142ef8f8a892a8fee8927" : {
      "comment" : "The Marginarium: Chapter 1: The Marginarium (marginarium); tableCell block. Preserve inline Markdown.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
