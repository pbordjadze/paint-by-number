        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エリアを横切って描くと、線なしで2つに分けます。どちらも絵の具はそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영역을 가로질러 그려 선 없이 둘로 나눠요. 두 쪽 모두 물감을 그대로 가져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teken over een vlak om het zonder lijn in tweeën te delen. Beide delen houden de verf."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenhe atravessando uma área para dividi-la em duas sem linha. As duas partes mantêm a tinta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
