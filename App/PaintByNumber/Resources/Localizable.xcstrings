    "Touch and hold a painting, then choose Favorite." : {
      "comment" : "Explanation under the No Favorites empty state of the gallery; Favorite is the context menu item's name",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte ein Bild gedrückt und wähle dann „Favorit“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado un cuadro y elige Favorito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez et maintenez un tableau, puis choisissez Ajouter aux favoris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca e tieni premuto un quadro, poi scegli Preferito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絵を長押しして、「お気に入り」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그림을 길게 누른 다음 즐겨찾기를 고르세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd een schilderij vast en kies dan Favoriet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e mantenha uma pintura, depois escolha Favoritar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住一幅画作，然后选择“收藏”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住一幅畫作，然後選擇「喜好」。"
          }
        }
      }
    },
    "Touch and hold to compare with the photo. Tap to keep it shown." : {
      "comment" : "VoiceOver hint of the Photo control on the painting screen",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berühren und halten, um mit dem Foto zu vergleichen. Tippen, damit es sichtbar bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado para comparar con la foto. Toca para que siga visible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez et maintenez pour comparer avec la photo. Touchez pour la garder affichée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca e tieni premuto per confrontare con la foto. Tocca per lasciarla visibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押しすると写真と比べられます。タップすると表示したままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "길게 누르면 사진과 비교할 수 있어요. 탭하면 계속 보여요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd vast om te vergelijken met de foto. Tik om haar te laten staan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e mantenha para comparar com a foto. Toque para deixar à mostra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住可与照片对比。轻点可让照片保持显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住即可與照片比較。點一下則會讓它持續顯示。"
          }
        }
      }
    },
