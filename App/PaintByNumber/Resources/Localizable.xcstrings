    "Double-tap the page to zoom in. Pinch to zoom back out." : {
      "comment" : "Message of the tip titled Zoom In on Small Areas; the page is the painting being painted",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe zweimal auf das Blatt, um hineinzuzoomen. Zieh zwei Finger zusammen, um wieder herauszuzoomen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces la página para acercarla. Pellizca para alejarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois la page pour zoomer. Pincez pour revenir en arrière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte la pagina per ingrandire. Avvicina le dita per tornare indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページをダブルタップすると拡大します。ピンチで元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페이지를 두 번 탭하면 확대돼요. 두 손가락을 오므리면 다시 축소돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik twee keer op het blad om in te zoomen. Knijp om weer uit te zoomen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes na página para dar zoom. Faça o gesto de pinça para afastar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连按两下画页即可放大。双指捏合可缩小回去。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點兩下頁面即可放大，捏合即可縮小。"
          }
        }
      }
    },
    "Drag the divider to compare the photo and the page. Pinch to look closer." : {
      "comment" : "Message of the tip titled Compare Photo and Page, at the divider between the photo and the page in the New Painting preview",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh den Trenner, um Foto und Blatt zu vergleichen. Zieh zwei Finger auseinander, um genauer hinzusehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
