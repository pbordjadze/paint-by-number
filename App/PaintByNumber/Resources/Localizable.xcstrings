    "Send goes straight to the people who make Paint by Moonlight." : {
      "comment" : "Feedback's review sheet: footer under what is sent; Send delivers the feedback to the developers directly",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Senden“ geht direkt an die Menschen, die Paint by Moonlight machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar llega directamente a las personas que hacen Paint by Moonlight."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer va directement aux personnes qui font Paint by Moonlight."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia arriva direttamente alle persone che creano Paint by Moonlight."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「送信」で、Paint by Moonlightを作っている人たちに直接届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보내기를 누르면 Paint by Moonlight를 만드는 사람들에게 바로 전해져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuur gaat rechtstreeks naar de mensen die Paint by Moonlight maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar vai direto para as pessoas que fazem o Paint by Moonlight."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“发送”会直接送到制作 Paint by Moonlight 的人手中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「傳送」會直接送到製作 Paint by Moonlight 的人手上。"
          }
        }
      }
    },
    "Send goes straight to the people who make Paint by Moonlight. Your photo helps us remake the painting; it goes only if you turn it on." : {
      "comment" : "Feedback's review sheet: footer under what is sent, for a painting made from the painter's own photo",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Senden“ geht direkt an die Menschen, die Paint by Moonlight machen. Dein Foto hilft uns, das Bild nachzubauen; es wird nur mitgeschickt, wenn du es einschaltest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar llega directamente a las personas que hacen Paint by Moonlight. Tu foto nos ayuda a rehacer el cuadro; solo se envía si la activas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer va directement aux personnes qui font Paint by Moonlight. Votre photo nous aide à refaire le tableau ; elle n’est envoyée que si vous l’activez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia arriva direttamente alle persone che creano Paint by Moonlight. La tua foto ci aiuta a ricreare il quadro; viene inviata solo se la attivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「送信」で、Paint by Moonlightを作っている人たちに直接届きます。写真は絵を作り直すのに役立ちます。写真はオンにしたときだけ送られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보내기를 누르면 Paint by Moonlight를 만드는 사람들에게 바로 전해져요. 사진은 그림을 다시 만들어 보는 데 도움이 되고, 켤 때만 함께 가요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuur gaat rechtstreeks naar de mensen die Paint by Moonlight maken. Met je foto kunnen we het schilderij opnieuw maken; hij gaat alleen mee als je hem aanzet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar vai direto para as pessoas que fazem o Paint by Moonlight. Sua foto nos ajuda a refazer a pintura; ela só vai se você ativar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“发送”会直接送到制作 Paint by Moonlight 的人手中。你的照片能帮我们重现这幅画作；只有你打开它，才会一起发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「傳送」會直接送到製作 Paint by Moonlight 的人手上。你的照片能幫助我們重新製作這幅畫作；只有在你打開時才會一起送出。"
          }
        }
      }
    },
    "Sending…" : {
