      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Foto von der Kamera ließ sich nicht verwenden. Versuch es noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The photo from the camera couldn’t be used. Try taking it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo usar la foto de la cámara. Prueba a hacerla de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La photo prise avec l’appareil photo n’a pas pu être utilisée. Essayez de la reprendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile usare la foto della fotocamera. Prova a scattarla di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラで撮った写真を使えませんでした。もう一度撮ってみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라로 찍은 사진을 쓸 수 없었어요. 다시 찍어 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De foto van de camera kon niet worden gebruikt. Probeer hem opnieuw te maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível usar a foto da câmera. Tente tirá-la de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法使用相机拍的照片。请再拍一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法使用相機拍的照片。請再拍一次。"
          }
        }
      }
    },
    "create.error.renderFailed" : {
      "comment" : "Error when the painting can't be made from the photo",
