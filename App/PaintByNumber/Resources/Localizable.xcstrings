            "state" : "translated",
            "value" : "Lleva un número a un sitio mejor de su celda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace un numéro vers un meilleur endroit de sa cellule."
          }
        },
        "it" : {
