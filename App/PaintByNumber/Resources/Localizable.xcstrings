          }
        }
      }
    },
    "lamp.caroline.line" : {
      "comment" : "The Marginarium, Who is Who: one line about Caroline",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has been making Paint by Moonlight with Paul from the start. Long before this book began, her feedback shaped many of his design choices, and much of what looks lovely here is thanks to her."
          }
        }
      }
    },
    "lamp.codex.name" : {
      "comment" : "The Marginarium, Who is Who: the name of Codex, an AI helper",
      "extractionState" : "manual",
      "localizations" : {
