          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste o divisor para comparar a foto e a página. Use a pinça para ver mais de perto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动分隔线来对比照片和画页。双指张开可以看得更仔细。"
