    "refine.hint.curve" : {
      "comment" : "Refine screen: how the Shapes tool's Curve works (a first drag places the curve's ends, a second bends it through the finger), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh von einem Ende der Kurve zum anderen, dann zieh, um sie zu biegen. Zwei Finger zoomen und bewegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag from one end of the curve to the other, then drag to bend it. Two fingers zoom and move."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra de un extremo de la curva al otro y luego arrastra para doblarla. Dos dedos hacen zoom y mueven."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser d’une extrémité de la courbe à l’autre, puis faites glisser pour l’arrondir. Deux doigts pour zoomer et déplacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina da un’estremità all’altra della curva, poi trascina per piegarla. Due dita per zoomare e spostarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲線の一方の端からもう一方の端へドラッグしてから、ドラッグして曲げます。2本指でズームと移動。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "곡선의 한쪽 끝에서 다른 쪽 끝까지 드래그한 다음, 다시 드래그해 휘게 해요. 두 손가락으로 확대하고 옮겨요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep van het ene eind van de boog naar het andere, en sleep dan om hem te buigen. Twee vingers zoomen en verschuiven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste de uma ponta da curva até a outra, depois arraste para curvá-la. Dois dedos dão zoom e movem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从曲线的一端拖到另一端，再拖动使它弯曲。双指缩放和移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從曲線的一端拖到另一端，再拖移讓它彎曲。兩指可縮放和移動。"
          }
        }
      }
    },
    "refine.hint.curve.bend" : {
      "comment" : "Refine screen: the Shapes tool's Curve once its ends are placed: a drag bends it through the finger, a tap keeps it a straight line",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen, um die Kurve zu biegen, oder tippen, damit sie gerade bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to bend the curve, or tap to keep it straight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para doblar la curva o toca para dejarla recta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour arrondir la courbe, ou touchez pour la laisser droite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per piegare la curva, o tocca per lasciarla dritta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグで曲線を曲げるか、タップでまっすぐのままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그해서 곡선을 휘거나, 탭해서 곧게 두세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep om de boog te buigen, of tik om hem recht te laten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para curvar, ou toque para deixar reta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动以弯曲曲线，或轻点使其保持笔直。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移來彎曲曲線，或點一下保持筆直。"
          }
        }
      }
    },
    "refine.hint.eraser" : {
      "comment" : "Refine screen: how the Eraser works (it takes out exactly the parts of lines it touches), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radiere genau das weg, was du berührst, oder tippe, um eine Stelle zu radieren. Zwei Finger zoomen und bewegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rub out just what you touch, or tap to erase a spot. Two fingers zoom and move."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra solo lo que tocas, o toca para borrar un punto. Dos dedos hacen zoom y mueven."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gommez juste ce que vous touchez, ou touchez pour effacer un point. Deux doigts pour zoomer et déplacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella solo ciò che tocchi, o tocca per cancellare un punto. Due dita per zoomare e spostarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触れた所だけを消します。タップすると一点を消します。2本指でズームと移動。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "닿은 곳만 문질러 지우거나, 탭해 한 점을 지워요. 두 손가락으로 확대하고 옮겨요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gum precies weg wat je raakt, of tik om een plekje weg te gummen. Twee vingers zoomen en verschuiven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apague só o que tocar, ou toque para apagar um ponto. Dois dedos dão zoom e movem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只擦掉你碰到的部分，或轻点擦掉一个点。双指缩放和移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只擦掉你碰到的地方，或點一下擦掉一個點。兩指可縮放和移動。"
          }
        }
      }
    },
    "refine.hint.fill" : {
      "comment" : "Refine screen: how the Fill tool works (a tap makes the closed shape of the drawing under it an area of its own, painted the photo's color where it was tapped; a tap in a filled area clears it), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe in eine geschlossene Form, um sie zu einer eigenen Fläche zu machen, im Farbton des Fotos an dieser Stelle. Tippe noch einmal, um das aufzuheben. Zwei Finger zoomen und bewegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap inside a closed shape to make it an area of its own, in the photo’s color there. Tap it again to clear it. Two fingers zoom and move."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dentro de una forma cerrada para convertirla en una zona propia, con el color de la foto en ese punto. Tócala otra vez para quitarla. Dos dedos hacen zoom y mueven."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez l’intérieur d’une forme fermée pour en faire une zone à part, de la couleur de la photo à cet endroit. Touchez-la à nouveau pour l’annuler. Deux doigts pour zoomer et déplacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca dentro una forma chiusa per farne un’area a sé, nella tinta della foto in quel punto. Toccala di nuovo per annullare. Due dita per zoomare e spostarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閉じた形の中をタップすると、その場所の写真の色で専用のエリアになります。もう一度タップすると元に戻ります。2本指でズームと移動。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "닫힌 모양 안을 탭하면 그곳의 사진 색으로 칠한 따로 된 영역이 돼요. 다시 탭하면 되돌려요. 두 손가락으로 확대하고 옮겨요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik binnen een gesloten vorm om er een eigen vlak van te maken, in de kleur van de foto daar. Tik er nog eens op om het te wissen. Twee vingers zoomen en verschuiven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque dentro de uma forma fechada para torná-la uma área própria, na cor da foto ali. Toque de novo para desfazer. Dois dedos dão zoom e movem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在封闭的形状里轻点，让它成为一个单独的区域，用那里照片的颜色。再点一次可清除。双指缩放和移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在封閉的形狀裡點一下，讓它自成一個區塊，塗上照片在那裡的顏色。再點一下即可清除。兩指可縮放和移動。"
          }
        }
      }
    },
    "refine.hint.line" : {
      "comment" : "Refine screen: how the Shapes tool's Line works (a drag draws a straight line from where it starts to where it ends), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
