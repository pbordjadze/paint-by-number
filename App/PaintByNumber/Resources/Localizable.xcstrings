    "settings.paintingLength.footer.detailed" : {
      "comment" : "Footer under the Painting Length setting when Detailed is chosen",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorgeschlagene Einstellungen zielen auf 45 Minuten oder mehr Malzeit. Kleine oder schlichte Fotos ergeben kürzere Bilder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggested settings aim for 45 minutes or more of painting. Small or simple photos make shorter paintings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes sugeridos buscan 45 minutos o más de pintura. Las fotos pequeñas o sencillas dan cuadros más cortos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages suggérés visent 45 minutes de peinture ou plus. Les photos petites ou simples donnent des tableaux plus courts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni suggerite puntano a 45 minuti o più di pittura. Le foto piccole o semplici danno quadri più brevi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おすすめの設定は、45分以上塗れる絵を目指します。小さな写真やシンプルな写真では、短めの絵になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추천 설정은 45분 이상 칠하는 그림을 목표로 해요. 작거나 단순한 사진은 더 짧은 그림이 돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorgestelde instellingen mikken op 45 minuten schilderen of meer. Kleine of eenvoudige foto’s geven kortere schilderijen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ajustes sugeridos buscam 45 minutos ou mais de pintura. Fotos pequenas ou simples dão pinturas mais curtas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建议设置会以 45 分钟或更长的绘画时间为目标。小的或简单的照片会画得更快。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建議的設定會以 45 分鐘以上的作畫時間為目標。小張或簡單的照片，畫起來會比較短。"
          }
        }
      }
    },
