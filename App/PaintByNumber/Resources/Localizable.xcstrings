                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld points"
                }
              }
            }
          }
        }
      }
    },
    "refine.card.color.hint" : {
      "comment" : "Refine screen, an area's card: VoiceOver hint of Color, a color picker for the paint of an area that is its paint's only area",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gives this paint a new color."
          }
        }
      }
    },
    "refine.card.only.hint" : {
      "comment" : "Refine screen, an area's card: VoiceOver hint of Only This Area, a color picker that gives the pressed area a paint of its own",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gives this area a color of its own; the other areas of its paint keep theirs."
          }
        }
      }
    },
    "refine.card.others.hint" : {
      "comment" : "Refine screen, an area's card: VoiceOver hint of Show Its Other Areas, which opens Paints with the area's paint picked",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows every area of this paint, glowing, in Paints."
          }
        }
      }
    },
    "refine.card.paint" : {
      "comment" : "Refine screen, an area's card: under the paint's color name, its number (formatted), then how many areas have that paint (\"3 areas\")",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paint %1$@ · %2$@"
          }
        }
      }
    },
    "refine.card.use.hint" : {
      "comment" : "Refine screen, an area's card: VoiceOver hint of one of the painting's paints, which the pressed area takes",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gives this area this paint."
          }
        }
      }
    },
    "refine.guide.basics.about" : {
      "comment" : "Tool Guide, The Basics: the paragraph that explains a picture's three layers (ink, cells, paint)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every picture has three layers. Ink is the lines you see. Cells are the areas the lines and edges make, each with its own number. Paint is the color of each cell. Each tool works on one layer, so drawing a line never changes a color you chose, and painting never moves a line."
          }
        }
      }
    },
    "refine.guide.basics.note1" : {
      "comment" : "Tool Guide, The Basics: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing is kept until you tap Done. Cancel puts everything back as it was when Refine opened."
          }
        }
      }
    },
    "refine.guide.basics.note2" : {
      "comment" : "Tool Guide, The Basics: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a tool can’t do something, a note at the top says why, and nothing changes."
          }
        }
      }
    },
    "refine.guide.basics.step1" : {
      "comment" : "Tool Guide, The Basics: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinch with two fingers to zoom, and drag with two fingers to move around."
          }
        }
      }
    },
    "refine.guide.basics.step2" : {
      "comment" : "Tool Guide, The Basics: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap with two fingers to undo. Undo and Redo are at the top too."
          }
        }
      }
    },
    "refine.guide.basics.step3" : {
      "comment" : "Tool Guide, The Basics: a step of How to Use It (a long press opens an area's card, with Only This Area)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press and hold any cell to see its paint, and to give that cell a color of its own."
          }
        }
      }
    },
    "refine.guide.basics.step4" : {
      "comment" : "Tool Guide, The Basics: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With an Apple Pencil, the Pencil draws and one finger moves the picture, so your hand leaves no mark. Double-tap the Pencil to switch between drawing and erasing."
          }
        }
      }
    },
    "refine.guide.basics.summary" : {
      "comment" : "Tool Guide, The Basics: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How a picture is made, and how to move around it."
          }
        }
      }
    },
    "refine.guide.basics.try" : {
      "comment" : "Tool Guide, The Basics: Try This, something to do on the practice picture (an evening with hills, a tree, a cottage with a four-paned window and the moon)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom in on the cottage’s window, then press and hold one of its panes."
          }
        }
      }
    },
    "refine.guide.bendLine.about" : {
      "comment" : "Tool Guide, Bend Line: the paragraph about what it does",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab a line and drag. The spot you grabbed goes where your finger goes, and the line bends smoothly around it, less the farther along. Its ends stay where they meet other lines, and the cells on either side keep their paint and follow the new shape."
          }
        }
      }
    },
    "refine.guide.bendLine.note1" : {
      "comment" : "Tool Guide, Bend Line: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A line can’t bend across another line, off the picture, or so far that a cell has no room for its number; a note says so. Try a shorter drag."
          }
        }
      }
    },
    "refine.guide.bendLine.note2" : {
      "comment" : "Tool Guide, Bend Line: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bend Line moves ink. To move a dashed edge between cells, use Move Edge."
          }
        }
      }
    },
    "refine.guide.bendLine.step1" : {
      "comment" : "Tool Guide, Bend Line: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put your finger on a line and drag."
          }
        }
      }
    },
    "refine.guide.bendLine.step2" : {
      "comment" : "Tool Guide, Bend Line: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The line shows where it will lie. Lift your finger to keep it."
          }
        }
      }
    },
    "refine.guide.bendLine.step3" : {
      "comment" : "Tool Guide, Bend Line: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag again to keep shaping."
          }
        }
      }
    },
    "refine.guide.bendLine.summary" : {
      "comment" : "Tool Guide, Bend Line: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag a line to reshape it."
          }
        }
      }
    },
    "refine.guide.bendLine.try" : {
      "comment" : "Tool Guide, Bend Line: Try This, something to do on the practice picture",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pull the far hills’ line up into a mountain."
          }
        }
      }
    },
    "refine.guide.brush.about" : {
      "comment" : "Tool Guide, the Paint Brush: the paragraph about what it does",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brush across the picture and the stroke takes the current paint, shaping cells as it goes: it joins the cells of that paint it touches, and makes a cell of its own across the others."
          }
        }
      }
    },
    "refine.guide.brush.note1" : {
      "comment" : "Tool Guide, the Paint Brush: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ink always stays on top: the brush paints under the lines."
          }
        }
      }
    },
    "refine.guide.brush.note2" : {
      "comment" : "Tool Guide, the Paint Brush: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Size is measured on the screen, so a zoomed-in brush paints finer."
          }
        }
      }
    },
    "refine.guide.brush.step1" : {
      "comment" : "Tool Guide, the Paint Brush: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a paint in the palette."
          }
        }
      }
    },
    "refine.guide.brush.step2" : {
      "comment" : "Tool Guide, the Paint Brush: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brush across the picture, or tap for a dab."
          }
        }
      }
    },
    "refine.guide.brush.step3" : {
      "comment" : "Tool Guide, the Paint Brush: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set Size for a wider or finer brush, and zoom in for detail."
          }
        }
      }
    },
    "refine.guide.brush.summary" : {
      "comment" : "Tool Guide, the Paint Brush: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paints a stroke in the current paint."
          }
        }
      }
    },
    "refine.guide.brush.try" : {
      "comment" : "Tool Guide, the Paint Brush: Try This, something to do on the practice picture",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick the cottage’s cream and paint a winding path across the near hill."
          }
        }
      }
    },
    "refine.guide.bucket.about" : {
      "comment" : "Tool Guide, the Bucket: the paragraph about what it does",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a cell to give it the current paint, the one marked in the palette. Only that cell changes: the other cells of its old paint keep theirs."
          }
        }
      }
    },
    "refine.guide.bucket.note1" : {
      "comment" : "Tool Guide, the Bucket: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A color the picture doesn’t have becomes a paint of its own the first time you pour it."
          }
        }
      }
    },
    "refine.guide.bucket.note2" : {
      "comment" : "Tool Guide, the Bucket: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two cells of one paint with no ink between them become one cell."
          }
        }
      }
    },
    "refine.guide.bucket.step1" : {
      "comment" : "Tool Guide, the Bucket: a step of How to Use It (the palette ends with a system color picker, New Paint)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a paint in the palette, or tap the color wheel at its end to choose any color."
          }
        }
      }
    },
    "refine.guide.bucket.step2" : {
      "comment" : "Tool Guide, the Bucket: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a cell to pour it in."
          }
        }
      }
    },
    "refine.guide.bucket.summary" : {
      "comment" : "Tool Guide, the Bucket: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pours the current paint into a cell."
          }
        }
      }
    },
    "refine.guide.bucket.try" : {
      "comment" : "Tool Guide, the Bucket: Try This, something to do on the practice picture (on it the roof and the moon are outlined only, in the paint around them)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a brick red from the color wheel and pour it into the cottage’s roof. Then pick the sky’s paint and pour it into the far hills."
          }
        }
      }
    },
    "refine.guide.cellEdge.about" : {
      "comment" : "Tool Guide, Cell Edge: the paragraph about what it does",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw across a cell to divide it in two. The new edge has no ink, so it won’t show as a line in the finished picture, and both cells keep their paint. Each is a cell of its own, which you can give another paint."
          }
        }
      }
    },
    "refine.guide.cellEdge.note1" : {
      "comment" : "Tool Guide, Cell Edge: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edges without ink show dashed while a Cells tool is picked."
          }
        }
      }
    },
    "refine.guide.cellEdge.note2" : {
      "comment" : "Tool Guide, Cell Edge: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To take an edge away again, Merge across it."
          }
        }
      }
    },
    "refine.guide.cellEdge.step1" : {
      "comment" : "Tool Guide, Cell Edge: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw across a cell from one of its edges to another, or draw a loop inside it."
          }
        }
      }
    },
    "refine.guide.cellEdge.step2" : {
      "comment" : "Tool Guide, Cell Edge: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give one side a new paint with the Bucket or the Paint Brush."
          }
        }
      }
    },
    "refine.guide.cellEdge.summary" : {
      "comment" : "Tool Guide, Cell Edge: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divides a cell without drawing a line."
          }
        }
      }
    },
    "refine.guide.cellEdge.try" : {
      "comment" : "Tool Guide, Cell Edge: Try This, something to do on the practice picture",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw an edge across the near hill. Its two halves keep one paint, each with a number of its own."
          }
        }
      }
    },
    "refine.guide.editPaint.about" : {
      "comment" : "Tool Guide, Edit Paint: the paragraph about what it does",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a paint by tapping a cell or its swatch, and give it a new color: every cell of that paint changes together. Drag one swatch onto another to make the two one paint."
          }
        }
      }
    },
    "refine.guide.editPaint.note1" : {
      "comment" : "Tool Guide, Edit Paint: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To change one cell alone, pour it with the Bucket, or press and hold it and choose Only This Area."
          }
        }
      }
    },
    "refine.guide.editPaint.step1" : {
      "comment" : "Tool Guide, Edit Paint: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a cell or a swatch to pick its paint. Its cells glow."
          }
        }
      }
    },
    "refine.guide.editPaint.step2" : {
      "comment" : "Tool Guide, Edit Paint: a step of How to Use It (Color is the panel's color picker)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose its new color with Color."
          }
        }
      }
    },
    "refine.guide.editPaint.step3" : {
      "comment" : "Tool Guide, Edit Paint: a step of How to Use It (Similar colors too is the panel's switch, in sentence case)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Similar colors too to move the paints near it along with it."
          }
        }
      }
    },
    "refine.guide.editPaint.step4" : {
      "comment" : "Tool Guide, Edit Paint: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag a swatch onto another to merge the two paints."
          }
        }
      }
    },
    "refine.guide.editPaint.summary" : {
      "comment" : "Tool Guide, Edit Paint: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes a paint’s color everywhere it’s used."
          }
        }
      }
    },
    "refine.guide.editPaint.try" : {
      "comment" : "Tool Guide, Edit Paint: Try This, something to do on the practice picture",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make the near hill an autumn orange. Then drag the window’s swatch onto the moon’s."
          }
        }
      }
    },
    "refine.guide.eraser.about" : {
      "comment" : "Tool Guide, the Eraser: the paragraph about what it does",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Eraser takes out the ink along your stroke, cut cleanly where it stops. Where it breaks a line between two cells, they become one, in the paint of the larger."
          }
        }
      }
    },
    "refine.guide.eraser.note1" : {
      "comment" : "Tool Guide, the Eraser: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Eraser takes ink only. To take away a dashed edge between cells, use Merge."
          }
        }
      }
    },
    "refine.guide.eraser.note2" : {
      "comment" : "Tool Guide, the Eraser: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tap the Apple Pencil to switch between the Pen and the Eraser."
          }
        }
      }
    },
    "refine.guide.eraser.step1" : {
      "comment" : "Tool Guide, the Eraser: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rub over the lines you want gone."
          }
        }
      }
    },
    "refine.guide.eraser.step2" : {
      "comment" : "Tool Guide, the Eraser: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap to take out a small dab."
          }
        }
      }
    },
    "refine.guide.eraser.step3" : {
      "comment" : "Tool Guide, the Eraser: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom in to erase finer: the Eraser keeps its size on the screen."
          }
        }
      }
    },
    "refine.guide.eraser.summary" : {
      "comment" : "Tool Guide, the Eraser: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rubs out the ink it touches."
          }
        }
      }
    },
    "refine.guide.eraser.try" : {
      "comment" : "Tool Guide, the Eraser: Try This, something to do on the practice picture",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rub out the cross in the cottage’s window, so its four panes become one."
          }
        }
      }
    },
    "refine.guide.eyedropper.about" : {
      "comment" : "Tool Guide, the Eyedropper: the paragraph about what it does",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a cell and its paint becomes the current paint. With the Photo view, it picks the photo’s color where you tap instead, or the paint that matches it."
          }
        }
      }
    },
    "refine.guide.eyedropper.note1" : {
      "comment" : "Tool Guide, the Eyedropper: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The palette marks the current paint."
          }
        }
      }
    },
    "refine.guide.eyedropper.step1" : {
      "comment" : "Tool Guide, the Eyedropper: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a cell to pick up its paint."
          }
        }
      }
    },
    "refine.guide.eyedropper.step2" : {
      "comment" : "Tool Guide, the Eyedropper: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch to Photo and tap to pick a color from the photo."
          }
        }
      }
    },
    "refine.guide.eyedropper.step3" : {
      "comment" : "Tool Guide, the Eyedropper: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Then pour it with the Bucket or brush it with the Paint Brush."
          }
        }
      }
    },
    "refine.guide.eyedropper.summary" : {
      "comment" : "Tool Guide, the Eyedropper: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picks up a paint from the picture."
          }
        }
      }
    },
    "refine.guide.eyedropper.try" : {
      "comment" : "Tool Guide, the Eyedropper: Try This, something to do on the practice picture",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick up the window’s yellow. Then switch to Photo and pick the peach glow above the hills."
          }
        }
      }
    },
    "refine.guide.fill.about" : {
      "comment" : "Tool Guide, Fill Shape: the paragraph about what it does",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap inside a shape outlined in ink and it becomes a cell of its own, painted the photo’s color where you tapped. Even a tiny shape keeps its number, smaller and read zoomed in."
          }
        }
      }
    },
    "refine.guide.fill.note1" : {
      "comment" : "Tool Guide, Fill Shape: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A shape that isn’t closed fills the area around it. Undo takes it back."
          }
        }
      }
    },
    "refine.guide.fill.note2" : {
      "comment" : "Tool Guide, Fill Shape: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fill Shape takes the photo’s colors. To pour a paint you chose, use the Bucket."
          }
        }
      }
    },
    "refine.guide.fill.step1" : {
      "comment" : "Tool Guide, Fill Shape: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap inside a closed shape."
          }
        }
      }
    },
    "refine.guide.fill.step2" : {
      "comment" : "Tool Guide, Fill Shape: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a filled shape again to take the fill out."
          }
        }
      }
    },
    "refine.guide.fill.summary" : {
      "comment" : "Tool Guide, Fill Shape: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makes a closed shape a cell of its own, in the photo’s color."
          }
        }
      }
    },
    "refine.guide.fill.try" : {
      "comment" : "Tool Guide, Fill Shape: Try This, something to do on the practice picture (its shapes are outlined in ink, in the paint around them)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap inside the moon, then the roof and the door."
          }
        }
      }
    },
    "refine.guide.looks.about" : {
      "comment" : "Tool Guide, Looks: the paragraph about what it does",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A look moves every paint together, toward a time of day or a painter’s colors, keeping the picture’s lights and darks. Photo goes back to the photo’s own colors."
          }
        }
      }
    },
    "refine.guide.looks.note1" : {
      "comment" : "Tool Guide, Looks: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One look at a time: a new look takes the place of the last."
          }
        }
      }
    },
    "refine.guide.looks.note2" : {
      "comment" : "Tool Guide, Looks: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paints a look makes alike become one paint, and a note says so."
          }
        }
      }
    },
    "refine.guide.looks.step1" : {
      "comment" : "Tool Guide, Looks: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a look."
          }
        }
      }
    },
    "refine.guide.looks.step2" : {
      "comment" : "Tool Guide, Looks: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slide Strength to set how far it goes."
          }
        }
      }
    },
    "refine.guide.looks.step3" : {
      "comment" : "Tool Guide, Looks: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Photo to go back to the photo’s colors."
          }
        }
      }
    },
    "refine.guide.looks.summary" : {
      "comment" : "Tool Guide, Looks: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recolors the whole picture in a mood."
          }
        }
      }
    },
    "refine.guide.looks.try" : {
      "comment" : "Tool Guide, Looks: Try This, something to do on the practice picture",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try each look on the evening, then turn its Strength down halfway."
          }
        }
      }
    },
    "refine.guide.merge.about" : {
      "comment" : "Tool Guide, Merge: the paragraph about what it does",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag across neighbouring cells to make them one. The cell you start in keeps its paint and number, and the lines and edges between them go."
          }
        }
      }
    },
    "refine.guide.merge.note1" : {
      "comment" : "Tool Guide, Merge: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merge takes away ink between the cells as well as dashed edges."
          }
        }
      }
    },
    "refine.guide.merge.note2" : {
      "comment" : "Tool Guide, Merge: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A paint left with no cells leaves the palette."
          }
        }
      }
    },
    "refine.guide.merge.step1" : {
      "comment" : "Tool Guide, Merge: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start in the cell whose paint you want to keep."
          }
        }
      }
    },
    "refine.guide.merge.step2" : {
      "comment" : "Tool Guide, Merge: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag across the cells beside it that should join it."
          }
        }
      }
    },
    "refine.guide.merge.summary" : {
      "comment" : "Tool Guide, Merge: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joins the cells you drag across into one."
          }
        }
      }
    },
    "refine.guide.merge.try" : {
      "comment" : "Tool Guide, Merge: Try This, something to do on the practice picture",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag across the window’s four panes to make one big pane."
          }
        }
      }
    },
    "refine.guide.moveEdge.about" : {
      "comment" : "Tool Guide, Move Edge: the paragraph about what it does",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab the border between two cells, inked or dashed, and drag it. One cell grows as the other shrinks, and both keep their paint."
          }
        }
      }
    },
    "refine.guide.moveEdge.note1" : {
      "comment" : "Tool Guide, Move Edge: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As with Bend Line, a border can’t cross another or leave a cell without room for its number."
          }
        }
      }
    },
    "refine.guide.moveEdge.note2" : {
      "comment" : "Tool Guide, Move Edge: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move Edge grabs the borders between cells. Bend Line grabs any line you drew."
          }
        }
      }
    },
    "refine.guide.moveEdge.step1" : {
      "comment" : "Tool Guide, Move Edge: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put your finger on the border between two cells and drag."
          }
        }
      }
    },
    "refine.guide.moveEdge.step2" : {
      "comment" : "Tool Guide, Move Edge: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lift your finger where the border should be."
          }
        }
      }
    },
    "refine.guide.moveEdge.summary" : {
      "comment" : "Tool Guide, Move Edge: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag the border between two cells to change their shapes."
          }
        }
      }
    },
    "refine.guide.moveEdge.try" : {
      "comment" : "Tool Guide, Move Edge: Try This, something to do on the practice picture",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag the border between the two hills down a little, between the tree and the cottage, so the far hills grow taller."
          }
        }
      }
    },
    "refine.guide.moveNumber.about" : {
      "comment" : "Tool Guide, Move Number: the paragraph about what it does",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While Move Number is picked, every cell shows its number. Drag one anywhere in its own cell where it fits, and it’s sized for the room there."
          }
        }
      }
    },
    "refine.guide.moveNumber.note1" : {
      "comment" : "Tool Guide, Move Number: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A number stays in its own cell, off the lines and clear of the cell’s other numbers."
          }
        }
      }
    },
    "refine.guide.moveNumber.note2" : {
      "comment" : "Tool Guide, Move Number: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a tight spot it gets smaller, but never smaller than a painter can read."
          }
        }
      }
    },
    "refine.guide.moveNumber.step1" : {
      "comment" : "Tool Guide, Move Number: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put your finger on a number and drag it."
          }
        }
      }
    },
    "refine.guide.moveNumber.step2" : {
      "comment" : "Tool Guide, Move Number: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lift your finger where it should sit."
          }
        }
      }
    },
    "refine.guide.moveNumber.summary" : {
      "comment" : "Tool Guide, Move Number: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves a number to a better spot in its cell."
          }
        }
      }
    },
    "refine.guide.moveNumber.try" : {
      "comment" : "Tool Guide, Move Number: Try This, something to do on the practice picture",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move the sky’s number up beside the moon."
          }
        }
      }
    },
    "refine.guide.open.hint" : {
      "comment" : "Refine screen: VoiceOver hint of the Tool Guide button, which opens a page per tool with a description and a practice canvas",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What each tool does, with a picture to try it on."
          }
        }
      }
    },
    "refine.guide.pen.about" : {
      "comment" : "Tool Guide, the Pen: the paragraph about what it does",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Pen draws ink: lines that show in the finished picture. A line that closes off a shape makes a new cell with its own number. Lines leave the colors alone, unless Color from Photo is on."
          }
        }
      }
    },
    "refine.guide.pen.note1" : {
      "comment" : "Tool Guide, the Pen: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A line that doubles back on itself can’t be drawn; a note says so."
          }
        }
      }
    },
    "refine.guide.pen.note2" : {
      "comment" : "Tool Guide, the Pen: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A shape too small for a number stays a line, and doesn’t become a cell."
          }
        }
      }
    },
    "refine.guide.pen.step1" : {
      "comment" : "Tool Guide, the Pen: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw with a finger or the Pencil."
          }
        }
      }
    },
    "refine.guide.pen.step2" : {
      "comment" : "Tool Guide, the Pen: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "End a line on another line to close a shape. With Snap on, an end that touches a line joins it."
          }
        }
      }
    },
    "refine.guide.pen.step3" : {
      "comment" : "Tool Guide, the Pen: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Color from Photo to give each new cell the photo’s color there."
          }
        }
      }
    },
    "refine.guide.pen.summary" : {
      "comment" : "Tool Guide, the Pen: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draws lines exactly where you draw them."
          }
        }
      }
    },
    "refine.guide.pen.try" : {
      "comment" : "Tool Guide, the Pen: Try This, something to do on the practice picture",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw a cloud in the sky, ending where you began. Then turn on Color from Photo and draw a line across the moon."
          }
        }
      }
    },
    "refine.guide.select.about" : {
      "comment" : "Tool Guide, Select: the paragraph about what it does",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a cell to select it. It glows, and the bar below shows its paint, how many cells use that paint and its share of the picture. Change Color there gives it a new color."
          }
        }
      }
    },
    "refine.guide.select.note1" : {
      "comment" : "Tool Guide, Select: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While a Cells tool is picked, dashed lines show the edges between cells that have no ink. They divide the paint, but won’t be drawn."
          }
        }
      }
    },
    "refine.guide.select.note2" : {
      "comment" : "Tool Guide, Select: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With any tool, press and hold a cell to open its card."
          }
        }
      }
    },
    "refine.guide.select.step1" : {
      "comment" : "Tool Guide, Select: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a cell to select it."
          }
        }
      }
    },
    "refine.guide.select.step2" : {
      "comment" : "Tool Guide, Select: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap it again to let it go."
          }
        }
      }
    },
    "refine.guide.select.step3" : {
      "comment" : "Tool Guide, Select: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Change Color to give it a color of its own."
          }
        }
      }
    },
    "refine.guide.select.summary" : {
      "comment" : "Tool Guide, Select: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows a cell: its paint and how much of the picture it covers."
          }
        }
      }
    },
    "refine.guide.select.try" : {
      "comment" : "Tool Guide, Select: Try This, something to do on the practice picture",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select the sky, then the moon, and compare how much of the picture each covers."
          }
        }
      }
    },
    "refine.guide.shape.about" : {
      "comment" : "Tool Guide, Shapes: the paragraph about what it does",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shapes draws a clean figure across a drag. Like the Pen, it draws ink, and a closed figure becomes a cell of its own."
          }
        }
      }
    },
    "refine.guide.shape.note1" : {
      "comment" : "Tool Guide, Shapes: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The figure shows as it will be while your finger is down, so you can adjust it before you let go."
          }
        }
      }
    },
    "refine.guide.shape.note2" : {
      "comment" : "Tool Guide, Shapes: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Snap on, a line’s ends join the lines they touch."
          }
        }
      }
    },
    "refine.guide.shape.step1" : {
      "comment" : "Tool Guide, Shapes: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a figure above the tools."
          }
        }
      }
    },
    "refine.guide.shape.step2" : {
      "comment" : "Tool Guide, Shapes: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag from one corner to the opposite one, or from one end of a line to the other."
          }
        }
      }
    },
    "refine.guide.shape.step3" : {
      "comment" : "Tool Guide, Shapes: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For a curve, drag its ends first, then drag again to bend it. A tap leaves it straight."
          }
        }
      }
    },
    "refine.guide.shape.summary" : {
      "comment" : "Tool Guide, Shapes: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draws straight lines, rectangles, ovals, curves, hexagons and stars."
          }
        }
      }
    },
    "refine.guide.shape.try" : {
      "comment" : "Tool Guide, Shapes: Try This, something to do on the practice picture",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw a star in the sky. Then pick the curve and give the cottage a path to its door."
          }
        }
      }
    },
    "refine.guide.smartEraser.about" : {
      "comment" : "Tool Guide, the Line Eraser: the paragraph about what it does",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a line and the Line Eraser takes it out from one junction to the next, the stretch between the lines it meets. Drag it to rub out what you touch, as the Eraser does."
          }
        }
      }
    },
    "refine.guide.smartEraser.note1" : {
      "comment" : "Tool Guide, the Line Eraser: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The stretch flashes as it goes, so you can see what the tap took."
          }
        }
      }
    },
    "refine.guide.smartEraser.note2" : {
      "comment" : "Tool Guide, the Line Eraser: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cells the line kept apart become one."
          }
        }
      }
    },
    "refine.guide.smartEraser.step1" : {
      "comment" : "Tool Guide, the Line Eraser: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a line to take it out, junction to junction."
          }
        }
      }
    },
    "refine.guide.smartEraser.step2" : {
      "comment" : "Tool Guide, the Line Eraser: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to rub out what you touch."
          }
        }
      }
    },
    "refine.guide.smartEraser.summary" : {
      "comment" : "Tool Guide, the Line Eraser: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takes out a whole line with one tap."
          }
        }
      }
    },
    "refine.guide.smartEraser.try" : {
      "comment" : "Tool Guide, the Line Eraser: Try This, something to do on the practice picture",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the line around the moon, then the cottage’s door."
          }
        }
      }
    },
    "refine.guide.text.about" : {
      "comment" : "Tool Guide, Writing: the paragraph about what it does",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When your photo has writing in it, the app finds it and draws its letters so they can be read. Writing shows the lines of words it found: tap one to turn it off or on, or drag across words it missed."
          }
        }
      }
    },
    "refine.guide.text.note1" : {
      "comment" : "Tool Guide, Writing: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writing changes how the picture is made, so it’s made again, with your other changes laid on it."
          }
        }
      }
    },
    "refine.guide.text.note2" : {
      "comment" : "Tool Guide, Writing: a note under Good to Know, where other pages have a practice picture",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There’s nothing to practice on here: the practice picture has no writing. Try it on a photo with a sign or a label."
          }
        }
      }
    },
    "refine.guide.text.step1" : {
      "comment" : "Tool Guide, Writing: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a line of words to turn it off or on."
          }
        }
      }
    },
    "refine.guide.text.step2" : {
      "comment" : "Tool Guide, Writing: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag across a line of words the app missed."
          }
        }
      }
    },
    "refine.guide.text.summary" : {
      "comment" : "Tool Guide, Writing: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the words in your photo readable."
          }
        }
      }
    },
    "refine.guide.tryPainting.about" : {
      "comment" : "Tool Guide, Try Painting: the paragraph about what it does",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try Painting opens the painting screen on the picture with your changes, so you can check that its cells are pleasant to paint and its numbers easy to find. Nothing you paint there is kept."
          }
        }
      }
    },
    "refine.guide.tryPainting.note1" : {
      "comment" : "Tool Guide, Try Painting: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your painting starts fresh once you tap Done in Refine and start painting it."
          }
        }
      }
    },
    "refine.guide.tryPainting.step1" : {
      "comment" : "Tool Guide, Try Painting: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make a change, then tap Try Painting."
          }
        }
      }
    },
    "refine.guide.tryPainting.step2" : {
      "comment" : "Tool Guide, Try Painting: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paint a few cells."
          }
        }
      }
    },
    "refine.guide.tryPainting.step3" : {
      "comment" : "Tool Guide, Try Painting: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close it to come back to Refine."
          }
        }
      }
    },
    "refine.guide.tryPainting.summary" : {
      "comment" : "Tool Guide, Try Painting: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paints the picture as it is now, to see how it feels."
          }
        }
      }
    },
    "refine.guide.tryPainting.try" : {
      "comment" : "Tool Guide, Try Painting: Try This, something to do on the practice picture",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw a line across the sky with the Pen, then tap Try Painting and paint both halves."
          }
        }
      }
    },
    "refine.guide.views.about" : {
      "comment" : "Tool Guide, Views: the paragraph about the views (Painting, Paper, Photo, Photo Behind)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The views at the top of Refine choose what you see beneath the ink. They change only what you see, never the picture."
          }
        }
      }
    },
    "refine.guide.views.note1" : {
      "comment" : "Tool Guide, Views: a note under Good to Know",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On iPhone, the views are in the menu at the top, which names the one showing."
          }
        }
      }
    },
    "refine.guide.views.step1" : {
      "comment" : "Tool Guide, Views: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Painting shows every cell in its paint, as the picture will look finished."
          }
        }
      }
    },
    "refine.guide.views.step2" : {
      "comment" : "Tool Guide, Views: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paper shows the lines alone, as the page looks before you paint."
          }
        }
      }
    },
    "refine.guide.views.step3" : {
      "comment" : "Tool Guide, Views: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo shows your photo under the lines."
          }
        }
      }
    },
    "refine.guide.views.step4" : {
      "comment" : "Tool Guide, Views: a step of How to Use It",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Behind lays the painting over your photo. Its slider sets how much of the photo shows through, for tracing."
          }
        }
      }
    },
    "refine.guide.views.summary" : {
      "comment" : "Tool Guide, Views: one line under its name in the guide's list and atop its page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What shows under the lines: the painting, paper or your photo."
          }
        }
      }
    },
    "refine.guide.views.try" : {
      "comment" : "Tool Guide, Views: Try This, something to do on the practice picture (the glow is in the photo, not a cell of its own)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Photo Behind, slide toward the photo, then trace the peach glow above the far hills with the Pen."
          }
        }
      }
    },
    "refine.hint.bendLine" : {
      "comment" : "Refine screen: how Bend Line works (a drag on a drawn line moves the part of it near the finger, the rest bending smoothly into place), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag a line to move it. It bends near where you hold it."
          }
        }
      }
    },
    "refine.hint.brush" : {
      "comment" : "Refine screen: how the Paint Brush works (where it is dragged becomes the paint picked in the palette, joining areas of that paint it meets; a tap paints a spot), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paint the current paint where you brush, or tap to paint a spot. It joins the areas of that paint it touches."
          }
        }
      }
    },
    "refine.hint.bucket" : {
      "comment" : "Refine screen: how the Bucket works (a tap gives the area under it the paint picked in the palette), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap an area to give it the current paint."
          }
        }
      }
    },
    "refine.hint.cellEdge" : {
      "comment" : "Refine screen: how Cell Edge works (a stroke divides an area where it goes, drawing no line; both parts keep their paint until painted), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw across an area to divide it in two with no line. Both parts keep the paint."
          }
        }
      }
    },
    "refine.hint.editPaint" : {
      "comment" : "Refine screen: how Edit Paint works (the current paint takes a new color from the color picker in every area that uses it; a tap on an area picks its paint), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give the current paint a new color everywhere it’s used. Tap an area to pick its paint."
          }
        }
      }
    },
    "refine.hint.eyedropper" : {
      "comment" : "Refine screen: how the Eyedropper works (a tap picks the paint of the area under it, or the photo's color there when the photo shows), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap an area to make its paint the current paint. Over the photo, tap to pick the photo’s color."
          }
        }
      }
    },
    "refine.hint.looks" : {
      "comment" : "Refine screen: how Looks works (a look changes every paint of the painting at once), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a look for every paint."
          }
        }
      }
    },
    "refine.hint.merge" : {
      "comment" : "Refine screen: how Merge works (a drag across areas joins them into one, taking the paint of the area the drag began in; the lines between them go), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag across areas to join them into one, in the first one’s paint."
          }
        }
      }
