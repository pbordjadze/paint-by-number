{
  "sourceLanguage" : "en",
  "strings" : {
    "About" : {
      "comment" : "Header of the About section in Settings",
      "extractionState" : "manual"
    },
    "Acknowledgements" : {
      "comment" : "Settings row, and the title of the screen it opens, crediting the sample pictures, artwork, and the code, models and methods behind the template engine",
      "extractionState" : "manual"
    },
    "acknowledgements.codeFooter" : {
      "comment" : "Footer under the Open-Source Code list in Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift ports of these libraries are part of the template engine."
          }
        }
      }
    },
    "acknowledgements.distanceTransforms.usage" : {
      "comment" : "What a credited third-party method or library is used for in the template engine (Distance transforms); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measures how thick each region is, so every area is big enough to paint."
          }
        }
      }
    },
    "acknowledgements.domainTransform.usage" : {
      "comment" : "What a credited third-party method or library is used for in the template engine (Domain transform); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smooths texture into painterly patches while keeping contours sharp."
          }
        }
      }
    },
    "acknowledgements.douglasPeucker.usage" : {
      "comment" : "What a credited third-party method or library is used for in the template engine (Douglas-Peucker); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thins out curve points that do not change the shape."
          }
        }
      }
    },
    "acknowledgements.earcut.usage" : {
      "comment" : "What a credited third-party method or library is used for in the template engine (Earcut); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triangulates each region's outline into the mesh the canvas paints."
          }
        }
      }
    },
    "acknowledgements.hed.usage" : {
      "comment" : "What a credited third-party method or library is used for in the template engine (Holistically-nested edge detection); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combines edges found at five scales into one map of a photo's lines."
          }
        }
      }
    },
    "acknowledgements.hedModel.usage" : {
      "comment" : "What a credited machine-learning model is used for (ControlNet's HED edge detector); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds the outlines of a photo, for coloring books."
          }
        }
      }
    },
    "acknowledgements.informativeDrawings.usage" : {
      "comment" : "What a credited third-party method or library is used for in the template engine (Informative drawings); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns a photo into a line drawing that keeps its geometry and meaning."
          }
        }
      }
    },
    "acknowledgements.lineArtModel.usage" : {
      "comment" : "What a credited machine-learning model is used for (the Informative Drawings line-drawing generator); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draws a photo's lines, fur, petals and glass, for coloring books."
          }
        }
      }
    },
    "acknowledgements.kmeans.usage" : {
      "comment" : "What a credited third-party method or library is used for in the template engine (k-means++); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picks well-spread starting colors for the palette."
          }
        }
      }
    },
    "acknowledgements.modelsFooter" : {
      "comment" : "Footer under the Models list in Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Machine-learning models that run on your device."
          }
        }
      }
    },
    "acknowledgements.oklab.usage" : {
      "comment" : "What a credited third-party method or library is used for in the template engine (OKLab); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compares colors the way the eye does when choosing the palette."
          }
        }
      }
    },
    "acknowledgements.pets.credit" : {
      "comment" : "How the Marginarium's pet images were generated and the terms they were made under; shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images generated by Codex with an OpenAI image model, via the Pets skill, under OpenAI's Terms of Use."
          }
        }
      }
    },
    "acknowledgements.pets.usage" : {
      "comment" : "Which artwork the Marginarium pets credit covers, including future guardians' pets; shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip, Colophon, and the guardians' pets as they arrive in the Marginarium."
          }
        }
      }
    },
    "acknowledgements.picture.byline" : {
      "comment" : "A credited picture's maker and date in Acknowledgements, as its source gives them; the arguments are the creator and the year, e.g. “Katsushika Hokusai, c. 1830–32”",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "acknowledgements.polylabel.usage" : {
      "comment" : "What a credited third-party method or library is used for in the template engine (Polylabel); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds the point of a region farthest from its edges, where its number is placed."
          }
        }
      }
    },
    "acknowledgements.potrace.usage" : {
      "comment" : "What a credited third-party method or library is used for in the template engine (Potrace); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns stair-stepped region outlines into smooth curves."
          }
        }
      }
    },
    "acknowledgements.rtv.usage" : {
      "comment" : "What a credited third-party method or library is used for in the template engine (Relative total variation); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tells texture from structure, so faces and edges keep their detail."
          }
        }
      }
    },
    "acknowledgements.splitmix.usage" : {
      "comment" : "What a credited third-party method or library is used for in the template engine (SplitMix64); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makes the same photo and settings always give the same template."
          }
        }
      }
    },
