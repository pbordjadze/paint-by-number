    "refine.hint.pen" : {
      "comment" : "Refine screen: how the Pen works (it draws lines into the painting's drawing just where they are drawn), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichne Linien genau dort, wo du zeichnest. Zwei Finger zoomen und bewegen, ein Tippen mit zwei Fingern widerruft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
