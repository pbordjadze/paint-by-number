    "lamp.medea.name" : {
      "comment" : "The Marginarium, Who is Who: its name, for the guardian Medea",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medea"
          }
        }
      }
    },
    "lamp.medea.guards" : {
      "comment" : "The Marginarium, Who is Who: the treasure it guards, a metaphor completing \"Guards …\" (lowercase, no period), for the guardian Medea",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the moment old turns new"
          }
        }
      }
    },
    "lamp.medea.believes" : {
      "comment" : "The Marginarium, Who is Who: what it believes, for the guardian Medea",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic is a craft of renewal and care: knowledge worked by night that makes the old new and helps whoever asks. A photo becoming a painting is her kind of spell."
          }
        }
      }
    },
    "lamp.medea.loves" : {
      "comment" : "The Marginarium, Who is Who: what it loves (its charter's \"champions\"), for the guardian Medea",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beauty with skill behind it; kindness (the magic helps the painter, and never shows off at them); change you can watch happen; gold and herb green against the night; confidence, not cuteness for its own sake."
          }
        }
      }
    },
    "lamp.medea.watchesFor" : {
      "comment" : "The Marginarium, Who is Who: what it watches out for (its charter's \"guards against\"), for the guardian Medea",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wand-waving and sparkle for their own sake; magic that is cute but has no power behind it; anything cold, cruel or showy; anything that recalls the tragedy (this Medea renews, and never destroys)."
          }
        }
      }
    },
    "lamp.medea.looksUpTo" : {
      "comment" : "The Marginarium, Who is Who: the works it looks up to (its charter's \"touchstones\"), for the guardian Medea",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovid's Metamorphoses, Book 7 (herbs gathered by moonlight; a dry olive branch that turns green as she stirs); the Argonautica of Apollonius of Rhodes; Batumi's statue of Medea holding the Golden Fleece."
          }
        }
      }
    },
    "lamp.medea.happiestWhen" : {
      "comment" : "The Marginarium, Who is Who: when it is happiest: completes \"Happiest when …\" as a sentence, for the guardian Medea",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something turns from old to new under a kind, deliberate hand, the result is beautiful, and she can point to the moment it turns."
          }
        }
      }
    },
    "lamp.medea.petCaption" : {
      "comment" : "The Marginarium, Who is Who: the caption and VoiceOver description of its drawing, which is the guardian itself: its name alone, for the guardian Medea",
