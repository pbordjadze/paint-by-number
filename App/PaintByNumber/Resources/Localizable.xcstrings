        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선을 드래그해 옮겨요. 잡은 곳 근처에서 휘어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep een lijn om haar te verplaatsen. Ze buigt bij de plek waar je haar vasthoudt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
