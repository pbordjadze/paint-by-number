        }
      }
    },
    "lamp.codex.line" : {
      "comment" : "The Marginarium, Who is Who: one line about Codex, whose pet is Pip, a teapot",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Builds the tools and draws the guardians. Its pet is Pip, a teapot."
          }
        }
      }
    },
    "lamp.claude.name" : {
