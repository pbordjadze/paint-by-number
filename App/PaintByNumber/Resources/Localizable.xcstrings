    },
    "The people" : {
      "comment" : "The Marginarium, Who is Who: heading above the people who make the app (Paul and Caroline)",
      "extractionState" : "manual"
    },
    "The helpers" : {
      "comment" : "The Marginarium, Who is Who: heading above the two AI helpers, Codex and Claude, and their pets",
      "extractionState" : "manual"
    },
    "The Lamp" : {
      "comment" : "The Marginarium, Who is Who: heading above what the Lamp, the panel of guardians, is",
      "extractionState" : "manual"
    },
    "lamp.about" : {
      "comment" : "The Marginarium, Who is Who: what the Lamp is, above its teams of guardians",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Lamp is a panel of imaginary guardians. Each one guards a single idea about how the app should feel, the way a dragon guards one treasure. They look at design choices, write in the margins, and work in teams of friends who care about similar things. One of them, Originality, can only say no. They give advice; a person always decides."
          }
        }
      }
    },
    "lamp.about.tap" : {
      "comment" : "The Marginarium, Who is Who: the hint above the guardians' cards",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a guardian to read about it."
          }
        }
      }
    },
    "Who's Who" : {
      "comment" : "The Marginarium: title of the page of people, AI helpers and guardians, with their pets",
      "extractionState" : "manual"
    },
    "lamp.guards" : {
      "comment" : "The Marginarium, Who is Who: what a guardian guards, under its name; the argument is the treasure, a lowercase phrase such as \"the storybook feel\"",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guards %@"
          }
        }
      }
    },
    "lamp.robber-girl.portrait" : {
      "comment" : "The Marginarium, Who is Who: a few words on who the guardian is, under its name on its own page, for the guardian The Robber Girl",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The girl from the 1957 film of Andersen's The Snow Queen, as Paul remembers her: a Georgian girl from the mountains, quick, loud, and kinder than she lets anyone see."
          }
        }
      }
    },
    "Team" : {
