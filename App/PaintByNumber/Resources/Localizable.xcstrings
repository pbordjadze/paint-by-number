    "lamp.dinotopia.after" : {
      "comment" : "The Marginarium, Who is Who: who or what it is named after, shown under its name, for the guardian Dino",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After James Gurney's Dinotopia books."
          }
        }
      }
    },
    "lamp.dinotopia.portrait" : {
      "comment" : "The Marginarium, Who is Who: a few words on who the guardian is, under its name on its own page, for the guardian Dino",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paul hatched Dino himself, in Codex: a long-necked dinosaur."
          }
        }
      }
    },
    "lamp.dinotopia.guards" : {
      "comment" : "The Marginarium, Who is Who: the treasure it guards, a metaphor completing \"Guards …\" (lowercase, no period), for the guardian Dino",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the storybook feel"
          }
        }
      }
    },
    "lamp.dinotopia.believes" : {
      "comment" : "The Marginarium, Who is Who: what it believes, for the guardian Dino",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A storybook feels real when its wonder is painted with care, like a land you could walk into, sketched by someone who was there."
          }
        }
      }
    },
    "lamp.dinotopia.loves" : {
      "comment" : "The Marginarium, Who is Who: what it loves (its charter's \"champions\"), for the guardian Dino",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The explorer's journal: sketches, maps, labels and notes in the margins; make-believe painted from careful looking, with real light and real weight; very different neighbors getting along; a warm welcome for the stranger who washes ashore."
          }
        }
      }
    },
    "lamp.dinotopia.watchesFor" : {
      "comment" : "The Marginarium, Who is Who: what it watches out for (its charter's \"guards against\"), for the guardian Dino",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wonder made carelessly or by formula; magic with no light and no weight; anything that leaves a newcomer standing outside; borrowing Gurney's dinosaurs instead of his care."
          }
        }
      }
    },
    "lamp.dinotopia.looksUpTo" : {
      "comment" : "The Marginarium, Who is Who: the works it looks up to (its charter's \"touchstones\"), for the guardian Dino",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "James Gurney's Dinotopia: A Land Apart from Time (1992), the journal of Arthur Denison, shipwrecked in 1862 with his son Will; The World Beneath (1995); Gurney's Imaginative Realism (2009)."
          }
        }
      }
    },
    "lamp.dinotopia.happiestWhen" : {
      "comment" : "The Marginarium, Who is Who: when it is happiest: completes \"Happiest when …\" as a sentence, for the guardian Dino",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A page feels like a journal found somewhere real, and a newcomer is made welcome."
          }
        }
      }
    },
    "lamp.dinotopia.petCaption" : {
