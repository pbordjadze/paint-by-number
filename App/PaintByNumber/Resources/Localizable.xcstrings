          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le séparateur pour comparer la photo et la page. Pincez pour regarder de plus près."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina il divisore per confrontare la foto e la pagina. Allarga le dita per guardare più da vicino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕切りをドラッグして、写真とページを比べましょう。ピンチで近くに寄れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구분선을 드래그해 사진과 페이지를 비교해 보세요. 두 손가락을 벌리면 더 가까이 볼 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
