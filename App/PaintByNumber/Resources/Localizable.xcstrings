    "lamp.bartimaeus.loves" : {
      "comment" : "The Marginarium, Who is Who: what it loves (its charter's \"champions\"), for the guardian Bart",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A narrator who talks back; asides that earn their place; wit with an edge, aimed up at the narrator and never down at the reader; the helper whose work is named; old magic with a long memory."
          }
        }
      }
    },
    "lamp.bartimaeus.watchesFor" : {
      "comment" : "The Marginarium, Who is Who: what it watches out for (its charter's \"guards against\"), for the guardian Bart",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomposity, his own included; footnotes that pad instead of land; jokes at the reader's expense; masters who take the credit for the work; borrowing a famous voice instead of finding one's own."
          }
        }
      }
    },
    "lamp.bartimaeus.looksUpTo" : {
