    "Waiting for approval. Your paintings unlock as soon as it comes." : {
      "comment" : "Note in the Unlimited Paintings sheet when the purchase waits for a parent's approval (Ask to Buy)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warte auf Zustimmung. Deine Bilder werden freigeschaltet, sobald sie kommt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando la aprobación. Tus cuadros se desbloquean en cuanto llegue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente d’approbation. Vos tableaux seront débloqués dès qu’elle arrivera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa di approvazione. I tuoi quadri si sbloccano appena arriva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認を待っています。承認されしだい、絵のロックが解除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인을 기다리고 있어요. 승인되면 바로 그림이 열려요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wacht op toestemming. Je schilderijen worden ontgrendeld zodra die er is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
