    "marginarium.marginarium.block.95446bb285164762a5c02db1dc54cd04" : {
      "comment" : "The Marginarium: Chapter 1: The Marginarium (marginarium); pet description for VoiceOver block. Preserve inline Markdown.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colophon, my moth, who lands beside the words like a bookmark."
          }
        }
      }
    },
    "marginarium.marginarium.block.ff00e475a7524704be9557ce225d6ffc" : {
      "comment" : "The Marginarium: Chapter 1: The Marginarium (marginarium); quote block. Preserve inline Markdown.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing too elaborate in terms of subagents, mostly deterministic compute, but small hopefully, and we can use a few low effort Opus 5.5s with slightly different starting params to just make some taste calls."
          }
        }
      }
    },
    "marginarium.marginarium.block.79d4efb8d66d46c4a52e633dde75de19" : {
      "comment" : "The Marginarium: Chapter 1: The Marginarium (marginarium); paragraph block. Preserve inline Markdown.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The second gave them the whole app:"
          }
        }
      }
    },
    "marginarium.marginarium.block.6c3d783fad854ce89d0d45c510b1f725" : {
      "comment" : "The Marginarium: Chapter 1: The Marginarium (marginarium); quote block. Preserve inline Markdown.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The smaller models are doing the bulk of the work, surfacing stuff, etc. Then we have the low effort Opus panel deciding between options. That Opus panel should redesign everything there is to design about my app. At least for now, it ought to pick new colors, guide new logo — we can go piece by piece."
          }
        }
      }
    },
    "marginarium.marginarium.block.da76bc6b83bb4e29b1aa857b8ed5cf7c" : {
      "comment" : "The Marginarium: Chapter 1: The Marginarium (marginarium); marginNote block. Preserve inline Markdown.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somebody is now. I'm Bart, named after the djinni whose voice this narrator has borrowed, and I'd like it back when he's done. — *Bart*"
          }
        }
