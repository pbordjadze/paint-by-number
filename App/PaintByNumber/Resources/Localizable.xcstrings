          }
        }
      }
    },
    "refine.hint.brush" : {
      "comment" : "Refine screen: how the Paint Brush works (where it is dragged becomes the paint picked in the palette, joining areas of that paint it meets; a tap paints a spot), read by VoiceOver as the hint of its button",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Male die aktuelle Farbe dort, wo du streichst, oder tippe für einen Tupfer. Sie verbindet sich mit den Flächen dieser Farbe, die sie berührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paint the current paint where you brush, or tap to paint a spot. It joins the areas of that paint it touches."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinta con la pintura actual por donde pasas el pincel, o toca para pintar un punto. Se une a las zonas de esa pintura que toca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peignez la peinture actuelle là où vous passez, ou touchez pour peindre un point. Elle rejoint les zones de cette peinture qu’elle touche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipingi con il colore attuale dove passi il pennello, o tocca per dipingere un punto. Si unisce alle aree di quel colore che tocca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "なでた所を今の絵の具で塗ります。タップすると一点を塗ります。触れた同じ絵の具のエリアとつながります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "붓질한 곳을 지금 물감으로 칠하거나, 탭해 한 점을 칠해요. 닿은 같은 물감의 영역과 합쳐져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schilder de huidige verf waar je strijkt, of tik om een plekje te schilderen. Vlakken met die verf die je raakt, gaan samen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinte com a tinta atual onde passar o pincel, ou toque para pintar um ponto. Ele junta as áreas dessa tinta que tocar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刷过的地方会涂上当前颜料，轻点可以涂一个点。它会与碰到的同种颜料区域合在一起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你刷過的地方塗上目前的顏料，或點一下塗一個點。它會與碰到的同色區塊合併。"
          }
        }
      }
    },
    "refine.hint.bucket" : {
