        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "흔들리는 선을 고르게 해요. 선이 손가락을 조금 늦게 따라와요. 끄면 그린 그대로 그려요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt een trillende lijn gelijkmatiger: de lijn loopt een beetje achter je vinger aan. Uit tekent precies zoals jij tekent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acerta uma linha trêmula: a linha segue um pouco atrás do seu dedo. Desativada, desenha exatamente como você desenha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让抖动的线条变匀称：线条会稍稍落后于你的手指。关闭时，线条会正好画在你画的地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓晃動的線條變平順：線條會稍微落後你的手指。關閉時會完全照你畫的樣子畫。"
          }
        }
      }
    },
