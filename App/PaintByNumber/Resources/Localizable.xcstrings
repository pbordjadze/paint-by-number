    "lamp.pirosmani.loves" : {
      "comment" : "The Marginarium, Who is Who: what it loves (its charter's \"champions\"), for the guardian Niko",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flat, warm color on a dark ground; animals and feasts; simple sincerity."
