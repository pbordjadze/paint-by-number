            "value" : "Enregistrer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存"
          }
        },
        "ko" : {
