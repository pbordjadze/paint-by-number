        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그린 곳에 그대로 선을 그려요. 두 손가락으로 확대하고 옮기며, 두 손가락으로 탭하면 실행 취소해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
