    "acknowledgements.distanceTransforms.usage" : {
      "comment" : "What a credited third-party method or library is used for in the template engine (Distance transforms); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measures how thick each region is, so every area is big enough to paint."
