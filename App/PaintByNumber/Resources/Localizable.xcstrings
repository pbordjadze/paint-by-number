    "unlock.error.unavailable" : {
      "comment" : "Message in the Unlimited Paintings sheet when the App Store can't offer the purchase (offline, or the store isn't reachable)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Unbegrenzte Bilder“ kann gerade nicht gekauft werden. Prüfe deine Verbindung und versuch es noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlimited Paintings can’t be bought right now. Check your connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora mismo no se pueden comprar Cuadros ilimitados. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tableaux illimités ne peut pas être acheté pour l’instant. Vérifiez votre connexion et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento non è possibile acquistare Quadri illimitati. Controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今は「絵を無制限に」を購入できません。接続を確認して、もう一度試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 무제한 그림을 구입할 수 없어요. 연결 상태를 확인하고 다시 시도해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onbeperkt schilderen kan nu niet worden gekocht. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível comprar Pinturas ilimitadas agora. Verifique a sua conexão e tente de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂时无法购买“无限画作”。请检查网络连接后再试一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前無法購買「無限畫作」。請檢查網路連線後再試一次。"
          }
        }
      }
    },
    "unlock.error.unverified" : {
      "comment" : "Message in the Unlimited Paintings sheet when a purchase's receipt couldn't be verified; Restore Purchases is the sheet's button",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der App Store konnte den Kauf nicht bestätigen. Versuch gleich „Käufe wiederherstellen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The App Store couldn’t confirm the purchase. Try Restore Purchases in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El App Store no pudo confirmar la compra. Prueba Restaurar compras dentro de un momento."
          }
