            "value" : "Voorgestelde instellingen mikken op ongeveer een halfuur schilderen. Kleine of eenvoudige foto’s geven kortere schilderijen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ajustes sugeridos buscam cerca de meia hora de pintura. Fotos pequenas ou simples dão pinturas mais curtas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建议设置会以大约半小时的绘画时间为目标。小的或简单的照片会画得更快。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建議的設定會以大約半小時的作畫時間為目標。小張或簡單的照片，畫起來會比較短。"
          }
        }
      }
    },
